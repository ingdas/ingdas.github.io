  "tutorials": {
    "blackbox": {
      "step1": {
        "text": "تختبئ كرة واحدة في هذا الصندوق ⁦4×4⁩. أطلق أشعة الليزر من النقاط المحيطة بالحافة، واستنتج أين لا بد أن تكون، ثم علّمها واضغط زر الزاوية."
      },
      "step2": {
        "text": "انقر النقطة الموجودة على **الحافة اليسرى، بمحاذاة الصف الثاني**. ينحرف الشعاع في طريقه ويخرج من مكان آخر؛ ويأخذ الطرفان الرقم نفسه."
      },
      "step3": {
        "text": "الآن أطلق النقطة الموجودة **أعلى العمود الثاني**. حرف **H** يعني أن الشعاع اصطدم بكرة مباشرةً ولم يخرج أبدًا."
      },
      "step4": {
        "text": "أطلق النقطة الموجودة **أعلى العمود الأول** أيضًا. حرف **R** يعني أن الشعاع ارتدّ عائدًا من حيث أتى، وهذا يحدث حين تجلس كرة قطريًا بجوار المنفذ."
      },
      "step5": {
        "text": "حرف R يضع كرة قطريًا بجوار العمود الأول، وحرف H يضع واحدة في مسار العمود الثاني: ولا يحقّق الشرطين معًا سوى هذا المربّع."
      },
      "step6": {
        "text": "**انقر ذلك المربّع** لتعلّم كرتك هناك."
      },
      "step7": {
        "text": "كل الكرات معلَّمة، فصارت **علامة الصح في الزاوية العليا** فعّالة. انقرها ليُراجَع جوابك."
      },
      "step8": {
        "text": "صحيح. أثناء اللعب، **انقر بالزر الأيمن** على مربّع لتقفله متى تأكدت أنه فارغ، و**حلّ** يكشف الجواب."
      }
    },
    "bridges": {
      "step1": {
        "text": "رقم كل جزيرة هو عدد أطراف الجسور التي تريدها. صِل كل الجزر في شبكة واحدة، بجسرين على الأكثر بين كل زوج، ودون أن يعبر جسر فوق آخر."
      },
      "step2": {
        "text": "الرقم **2 في الأسفل** لا تحاذيه إلا جزيرة واحدة: الرقم **4** في الأعلى. **اسحب** من الـ2 نحو الـ4 لتمدّ جسرًا."
      },
      "step3": {
        "text": "إنه يريد طرفَي جسرين، وهذا الزوج هو المكان الوحيد الممكن لهما. **اسحب** بالطريقة نفسها مرة أخرى لجسر ثانٍ موازٍ."
      },
      "step4": {
        "text": "انتهت تلك الجزيرة. **انقرها** لتعلّمها منتهية: تصير رمادية وتُقفل جسورها، فلا تعبث بها من غير قصد."
      },
      "step5": {
        "text": "لا يجوز أن يعبر جسر فوق آخر، فالخط بين الرقمين **1 و1** صار مستحيلًا الآن. **اسحب بالزر الأيمن** من الـ1 اليسرى نحو اليمنى لتدوّن ذلك."
      },
      "step6": {
        "text": "لكل 1 الآن مخرج واحد، وتتبع ذلك الجسور الأربعة الباقية. **حلّ** يُنهي اللغز (و**G** يُظهر كل خط يصلح لجسر).",
        "textTouch": "لكل 1 الآن مخرج واحد، وتتبع ذلك الجسور الأربعة الباقية. **حلّ** يُنهي اللغز."
      }
    },
    "cube": {
      "step1": {
        "text": "للمكعّب ستة أوجه، وستة مربّعات ملوّنة بالأزرق. دحرِجه حتى يجمع كل وجه واحدًا منها: في كل مرة يستقرّ فيها، يتبادل الوجه السفلي والمربّع لونيهما."
      },
      "step2": {
        "text": "النقرة تقلب المكعّب فوق حافته نحو المربّع الذي تختاره. **انقر المربّع الأزرق أسفل المكعّب مباشرةً** لينتقل لونه إلى الوجه الذي يستقرّ عليه."
      },
      "step3": {
        "text": "المربّع الذي غادره صار عاديًا — فاللونان يتبادلان فعلًا. **انقر المربّع الأزرق على اليمين** ليصير وجه ثانٍ أزرق."
      },
      "step4": {
        "text": "**مفاتيح الأسهم** تدحرج المكعّب أيضًا. اضغط **→** مرة واحدة لالتقاط المربّع الأزرق الثالث.",
        "textTouch": "كل مربّع مجاور على بُعد لمسة واحدة. **المس المربّع الأزرق التالي على اليمين** لالتقاط المربّع الأزرق الثالث."
      },
      "step5": {
        "text": "ثلاثة أوجه زرقاء وبقيت ثلاثة — يمكن إنهاء هذه اللوحة بست دحرجات في المجمل، وشريط الحالة يعدّها. و**تراجع** يعيد واحدة حين تتجاوز هدفك."
      }
    },
    "dominosa": {
      "step1": {
        "text": "ثلاث قطع دومينو — 0-0 و0-1 و1-1 — رُصّت هنا ثم رُفعت وتركت أرقامها. قسّم الشبكة إلى أزواج لتعيد كلًا منها مرة واحدة بالضبط."
      },
      "step2": {
        "text": "لا يجوز استخدام قطعة مرتين. لو أقرنت هذا **0** بالـ**1** تحته لصار العمودان الخارجيان كلاهما 0-1، لذا **انقر بالزر الأيمن** بينهما لتدوّن أنهما ليسا زوجًا."
      },
      "step3": {
        "text": "الـ**0**ان الوحيدان المتلاصقان هما الزوج في الزاوية العليا اليسرى، فهناك موضع القطعة 0-0. **انقر الحدّ بينهما** لتضعها."
      },
      "step4": {
        "text": "وكذلك الـ**1**ان المتلاصقان الوحيدان هما الاثنان في أسفل اليسار. انقر الحدّ بينهما لتضع القطعة 1-1."
      },
      "step5": {
        "text": "يبقى العمود الأيمن للقطعة 0-1. انقر الحدّ بين رقميه لتنتهي."
      },
      "step6": {
        "text": "كل قطعة استُخدمت مرة واحدة. انقر قطعة مرة أخرى لترفعها، والقطعة المكرّرة تُرسم بالأحمر، و**تراجع** يعيدك خطوة خطوة."
      }
    },
    "fifteen": {
      "step1": {
        "text": "أزِح القطع المرقّمة إلى الفراغ حتى تُقرأ **من 1 إلى 8** بالترتيب، والفراغ في الزاوية السفلى اليمنى. هذه اللوحة الصغيرة على بعد نقلتين من النهاية."
      },
      "step2": {
        "text": "أي قطعة في صف الفراغ أو عموده يمكنها الانزلاق. انقر **5** لتدفعها إلى الفراغ."
      },
      "step3": {
        "text": "نقلة أخرى فقط. انقر **8** لتكمل الصف."
      },
      "step4": {
        "text": "تم الحل! **تراجع** و**إعادة** يتنقّلان بين نقلاتك، و**جديد** في قائمة الإيقاف المؤقت يوزّع لغزًا جديدًا. ومفاتيح الأسهم تُزلق قطعة إلى الفراغ أيضًا، في اتجاه السهم.",
        "textTouch": "تم الحل! **تراجع** و**إعادة** يتنقّلان بين نقلاتك، و**جديد** في قائمة الإيقاف المؤقت يوزّع لغزًا جديدًا. وينزلق صف أو عمود كامل دفعةً واحدة، فاستهدف القطعة الأبعد."
      }
    },
    "filling": {
      "step1": {
        "text": "اكتب رقمًا في كل مربّع فارغ بحيث تغطي كل كتلة متصلة من الأرقام المتساوية عددًا من المربّعات يساوي الرقم نفسه بالضبط."
      },
      "step2": {
        "text": "الرقم **3** في أسفل العمود الأوسط لا يمكنه النمو إلا صعودًا، فكتلته هي ذلك العمود. **اسحب** من أعلى مربّع فيه نزولًا إلى الأوسط، ثم اضغط **3**.",
        "textTouch": "الرقم **3** في أسفل العمود الأوسط لا يمكنه النمو إلا صعودًا. **اسحب** من أعلى مربّع فيه نزولًا إلى الأوسط، ثم المس **3** على لوحة الأزرار."
      },
      "step3": {
