    "lightup": {
      "step1": {
        "text": "Alle hvide felter skal ende med at være oplyst. En pære lyser sin egen række og kolonne op, indtil et sort felt spærrer for strålen, og ingen pære må stå i en andens lys."
      },
      "step2": {
