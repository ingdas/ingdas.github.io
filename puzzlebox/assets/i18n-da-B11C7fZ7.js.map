    },
    "inertia": {
      "step1": {
        "text": "Du er kuglen i øverste venstre hjørne, og der er **tre ædelstene** at samle. Når kuglen først ruller, standser den kun ved en mur eller et stop — og en mine slår den ihjel."
      },
      "step2": {
        "text": "Klik på et felt til **højre** for kuglen. Den ruller den vej, indtil brættets kant stopper den, og samler ædelstenen op undervejs."
      },
      "step3": {
        "text": "Klik nu **under** kuglen. Den tager den næste ædelsten, og den brudte ring to felter nede — et stop — bringer den til standsning."
      },
      "step4": {
        "text": "Pas på: den piggede tingest lige under kuglen er en **mine**. Ruller du ind på en, er spillet slut, og kun Fortryd redder dig ud."
      },
      "step5": {
        "text": "Gå **diagonalt** i stedet: klik på feltet to ned og to til venstre, så glider kuglen forbi minen hen til den sidste ædelsten."
      },
      "step6": {
        "text": "Alle tre ædelstene — færdig! **Fortryd** spoler et mislykket rul tilbage; piletasterne ruller lige, og Home, Page Up, End og Page Down ruller diagonalt.",
        "textTouch": "Alle tre ædelstene — færdig! **Fortryd** spoler et mislykket rul tilbage, og du kan også trykke uden for gitteret, hvilket hjælper, når kuglen ligger op ad en kant."
      }
    },
    "keen": {
      "step1": {
        "text": "Udfyld med 1, 2 og 3, så hvert tal optræder én gang i hver række og kolonne, og så cifrene i hvert kraftigt optegnet bur passer med burets regnestykke."
