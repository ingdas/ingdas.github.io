  "tutorials": {
    "blackbox": {
      "step1": {
        "text": "Én kugle gemmer sig i denne 4×4-boks. Skyd lasere ind fra prikkerne langs kanten, regn ud hvor den må være, markér den, og tryk på knappen i hjørnet."
      },
      "step2": {
        "text": "Klik på prikken på **venstre kant ud for anden række**. Strålen bøjes undervejs og kommer ud et andet sted; begge ender får samme tal."
      },
      "step3": {
        "text": "Skyd nu fra prikken **øverst i anden kolonne**. Et **H** betyder, at strålen ramte en kugle direkte og aldrig kom ud."
      },
      "step4": {
        "text": "Skyd også fra prikken **øverst i første kolonne**. Et **R** betyder, at strålen røg lige ud igen — det sker, når en kugle ligger diagonalt ved siden af porten."
      },
      "step5": {
        "text": "R'et placerer en kugle diagonalt ved første kolonne, og H'et placerer en lige ned ad den anden: kun dette felt opfylder begge dele."
      },
      "step6": {
        "text": "**Klik på det felt** for at markere din kugle der."
      },
      "step7": {
        "text": "Alle kugler er markeret, så **fluebenet i øverste venstre hjørne** er aktivt. Klik på det for at få dit svar tjekket."
      },
      "step8": {
        "text": "Rigtigt! Undervejs kan du **højreklikke** på et felt for at låse det, når du er sikker på, at det er tomt, og **Løs** afslører svaret."
      }
    },
    "bridges": {
      "step1": {
        "text": "Tallet på en ø siger, hvor mange broender den vil have. Forbind alle øer til ét netværk, med højst to broer mellem to øer og ingen broer, der krydser hinanden."
      },
      "step2": {
        "text": "**2-tallet nederst** har kun én ø på linje med sig: **4-tallet** øverst. **Træk** fra 2-tallet mod 4-tallet for at slå en bro."
      },
      "step3": {
        "text": "Den vil have to broender, og det par er det eneste sted, de kan ligge. **Træk** samme vej igen for endnu en parallel bro."
      },
      "step4": {
        "text": "Den ø er færdig. **Klik** på den for at markere den som færdig: den bliver grå, og dens broer låses, så du ikke kommer til at rykke ved dem."
      },
      "step5": {
        "text": "Ingen bro må krydse en anden, så linjen mellem **de to 1-taller** er død nu. **Højreklik og træk** fra det venstre 1-tal mod det højre for at notere det."
      },
      "step6": {
        "text": "Hvert 1-tal har nu kun én udvej, og de fire sidste broer følger af det. **Løs** gør puslespillet færdigt (og **G** viser alle linjer, en bro kunne følge).",
        "textTouch": "Hvert 1-tal har nu kun én udvej, og de fire sidste broer følger af det. **Løs** gør puslespillet færdigt."
      }
