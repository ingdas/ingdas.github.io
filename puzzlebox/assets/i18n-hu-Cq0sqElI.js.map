  "tutorials": {
    "blackbox": {
      "step1": {
        "text": "Ebben a 4×4-es dobozban egy golyó rejtőzik. Lőj be lézereket a szélen álló pontokból, gondold ki, hol kell lennie, jelöld meg, és nyomd meg a sarokgombot."
      },
      "step2": {
        "text": "Kattints a **bal szélen, a második sor magasságában** álló pontra. A sugár útközben elhajlik, és máshol jön ki; a két végét ugyanaz a szám jelöli."
      },
      "step3": {
        "text": "Most lőj a **második oszlop tetején** álló pontból. A **H** azt jelenti, hogy a sugár egyenesen egy golyóba futott, és soha nem jött ki."
      },
      "step4": {
        "text": "Lőj az **első oszlop tetején** álló pontból is. Az **R** azt jelenti, hogy a sugár rögtön visszapattant; ez akkor történik, ha a nyílás mellett átlósan golyó áll."
      },
      "step5": {
        "text": "Az R szerint az első oszlop mellett átlósan van egy golyó, a H szerint pedig a második oszlopban lefelé: csak ez az egy mező felel meg mindkettőnek."
      },
      "step6": {
        "text": "**Kattints arra a mezőre**, hogy odajelöld a golyót."
      },
      "step7": {
        "text": "Minden golyó meg van jelölve, így a **bal felső sarokban lévő pipa** aktív. Kattints rá, és a játék ellenőrzi a válaszodat."
      },
      "step8": {
        "text": "Helyes! Játék közben **jobb gombbal kattintva** lelakatolhatod azt a mezőt, amelyről már biztosan tudod, hogy üres, a **Megoldás** pedig elárulja a választ."
      }
    },
    "bridges": {
      "step1": {
        "text": "Minden szigeten a szám azt mondja meg, hány hídvéget kér. Kösd egyetlen hálózattá az összes szigetet: két sziget közé legfeljebb két híd kerülhet, és hidak nem keresztezhetik egymást."
      },
      "step2": {
        "text": "Az **alsó 2**-essel csak egy sziget van egy vonalban: a felső **4**-es. **Húzz** a 2-estől a 4-es felé, és átdobsz egy hidat."
      },
      "step3": {
        "text": "Két hídvéget kér, és csak ez az egy pár jöhet szóba. **Húzz** még egyszer ugyanúgy egy második, párhuzamos hídért."
      },
      "step4": {
        "text": "Ez a sziget kész. **Kattints** rá, hogy késznek jelöld: szürke lesz, a hídjai pedig rögzülnek, így véletlenül sem tudod elrontani őket."
      },
      "step5": {
        "text": "Hidak nem keresztezhetik egymást, így a **két 1-es** közötti összeköttetés már szóba sem jöhet. **Jobb gombbal húzz** a bal 1-estől a jobb felé, hogy ezt beceruzázd."
      },
      "step6": {
        "text": "Mindegyik 1-esnek egy kijárata maradt, és ebből következik a maradék négy híd. A **Megoldás** befejezi a rejtvényt (a **G** pedig megmutat minden vonalat, amerre híd futhat).",
        "textTouch": "Mindegyik 1-esnek egy kijárata maradt, és ebből következik a maradék négy híd. A **Megoldás** befejezi a rejtvényt."
      }
    },
    "cube": {
      "step1": {
        "text": "A kockának hat lapja van, és hat mező kék. Görgesd addig, amíg minden lap össze nem szed egyet: valahányszor letoppan, az alsó lap és a mező színt cserél."
      },
      "step2": {
        "text": "Egy kattintás a választott mező felé billenti át a kockát az élén. **Kattints a kocka alatti kék mezőre**, hogy a színe a leérkező lapra kerüljön."
      },
      "step3": {
        "text": "Az elhagyott mező most üres — a színek tényleg cserélődnek. **Kattints a jobbra lévő kék mezőre**, hogy egy második lap is kék legyen."
      },
      "step4": {
        "text": "A **nyílbillentyűk** is görgetik a kockát. Nyomd meg egyszer a **→** gombot, és felszeded a harmadik kék mezőt.",
        "textTouch": "Minden szomszédos mező egyetlen koppintásnyira van. **Koppints a jobbra következő kék mezőre**, és felszeded a harmadik kék mezőt."
      },
      "step5": {
        "text": "Három lap kék, három van hátra — ez a tábla összesen hat gördüléssel megoldható, és az állapotsor számolja őket. A **Vissza** visszavesz egyet, ha túllőttél a célon."
      }
    },
    "dominosa": {
      "step1": {
        "text": "Három dominót — 0-0, 0-1 és 1-1 — raktak ki ide, majd elvették őket, csak a számaik maradtak. Oszd párokra a rácsot, hogy mindegyik pontosan egyszer kerüljön vissza."
      },
      "step2": {
        "text": "Egy dominó sem használható kétszer. Ha ezt a **0**-t az alatta lévő **1**-essel pároznád, mindkét szélső oszlop 0-1 lenne, ezért **kattints jobb gombbal** közéjük, jelezve, hogy nem alkotnak párt."
      },
      "step3": {
        "text": "Az egyetlen két egymáshoz érő **0** a bal felső sarokban van, tehát oda kerül a 0-0. **Kattints a köztük lévő határra**, és lerakod."
      },
      "step4": {
        "text": "Ugyanígy az egyetlen két egymáshoz érő **1**-es a bal alsó részen van. Kattints a köztük lévő határra az 1-1-ért."
      },
      "step5": {
        "text": "Így a jobb oldali oszlop marad a 0-1-nek. Kattints a két száma közötti határra, és kész."
      },
      "step6": {
        "text": "Minden dominó pontosan egyszer szerepel. Kattints újra egy dominóra, ha felvennéd; az ismétlődő pirosan látszik, a **Vissza** pedig visszalépked a lépéseiden."
      }
    },
    "fifteen": {
      "step1": {
        "text": "Told a számozott lapkákat az üres helyre, amíg **1-től 8-ig** sorrendben nem állnak, és a rés a jobb alsó sarokba nem kerül. Ez a kis tábla két lépésre van a megoldástól."
      },
      "step2": {
        "text": "A réssel egy sorban vagy oszlopban álló bármelyik lapka csúsztatható. Kattints az **5**-ösre, hogy felfelé told a résbe."
      },
      "step3": {
        "text": "Még egy. Kattints a **8**-asra, és kész a sor."
      },
      "step4": {
        "text": "Megoldva! A **Vissza** és az **Előre** végiglépked a lépéseiden, a szünetmenü **Új** gombja pedig friss rejtvényt oszt. A nyílbillentyűkkel is betolhatsz egy lapkát a résbe, a nyíl irányába.",
        "textTouch": "Megoldva! A **Vissza** és az **Előre** végiglépked a lépéseiden, a szünetmenü **Új** gombja pedig friss rejtvényt oszt. Egész sor vagy oszlop csúszik egyszerre, úgyhogy a távolabbi lapkát célozd."
      }
    },
    "filling": {
      "step1": {
        "text": "Írj számjegyet minden üres mezőbe úgy, hogy az azonos számjegyekből álló, összefüggő blokkok pontosan annyi mezőt fedjenek, amennyit a számjegyük mond."
      },
      "step2": {
        "text": "A középső oszlop alján álló **3**-as csak felfelé nőhet, tehát a blokkja maga az oszlop. **Húzz** a legfelső mezőjétől a középsőig, majd nyomd meg a **3**-ast.",
        "textTouch": "A középső oszlop alján álló **3**-as csak felfelé nőhet. **Húzz** a legfelső mezőjétől a középsőig, majd koppints a billentyűk közül a **3**-asra."
      },
      "step3": {
        "text": "A bal oszlopban álló **2**-esnek egy társ kell, és csak a fölötte lévő mező szabad. Kattints arra a mezőre, és nyomd meg a **2**-est.",
        "textTouch": "A bal oszlopban álló **2**-esnek egy társ kell, és csak a fölötte lévő mező szabad. Koppints arra a mezőre, majd a billentyűsoron a **2**-esre."
      },
      "step4": {
        "text": "Egy mező maradt. Kattints rá, és nyomd meg az **1**-est, hogy lásd, hogy néz ki egy rossz számjegy.",
        "textTouch": "Egy mező maradt. Koppints rá, majd a billentyűsoron az **1**-esre, hogy lásd, hogy néz ki egy rossz számjegy."
      },
      "step5": {
        "text": "A piros lehetetlent jelent: az a két **1**-es érintkezik, ami kétmezős blokk lenne, a felső **2**-es pedig be van falazva. Az a mező még ki van jelölve, úgyhogy nyomd meg a **Backspace**-t, hogy kiürítsd.",
        "textTouch": "A piros lehetetlent jelent: az a két **1**-es érintkezik, ami kétmezős blokk lenne, a felső **2**-es pedig be van falazva. Az a mező még ki van jelölve, úgyhogy koppints a billentyűsoron a **⌫** gombra, hogy kiürítsd."
      },
      "step6": {
        "text": "Az az üres mező inkább a fölötte lévő **2**-essel áll párba. Kattints rá, és nyomd meg a **2**-est, hogy befejezd a rácsot.",
        "textTouch": "Az az üres mező inkább a fölötte lévő **2**-essel áll párba. Koppints rá, majd a billentyűsoron a **2**-esre, hogy befejezd a rácsot."
      },
      "step7": {
        "text": "Kitöltve. Vastag vonalak zárják körbe a kész blokkokat; a **jobb gombos kattintás** egyesével ad mezőket a kijelöléshez, a **Vissza** pedig visszavon egy kitöltést."
      }
    },
    "flip": {
      "step1": {
        "text": "Világítsd ki mind a kilenc mezőt. Ha megnyomsz egyet, önmagát **és** a körülötte lévőket is átfordítja, így a világos mezők újra elsötétülhetnek."
      },
      "step2": {
        "text": "A mezőben álló kis ábra mutatja, mit fordít át: a tömör négyzet maga a mező, a körvonalasak a szomszédai."
      },
      "step3": {
        "text": "Ideje kivilágítani. Nyomd meg a **bal felső** mezőt, a sötétet a sarokban."
      },
      "step4": {
        "text": "A sarok világít, de a két szomszédja elsötétült. Most nyomd meg a **középső** mezőt."
      },
      "step5": {
        "text": "Már csak a jobb alsó sarok sötét. Nyomd meg a **jobb alsó** mezőt, és kész."
      },
      "step6": {
        "text": "Minden világít! A **Vissza** visszavon egy nyomást, és a nyílbillentyűkkel kurzort is mozgathatsz, kattintás helyett Enterrel.",
        "textTouch": "Minden világít! A **Vissza** visszavon egy nyomást, és ugyanannak a mezőnek a kétszeri megnyomása mindig kioltja egymást, úgyhogy a sorrend soha nem számít."
      }
    },
    "flood": {
      "step1": {
        "text": "A tiéd a bal felső mező és minden vele azonos színben összefüggő mező. Minden lépés átfesti ezt a foltot, így a hozzá érő, új színű mezők is csatlakoznak. Tedd az egész rácsot egyszínűvé **négy lépésen** belül."
      },
      "step2": {
        "text": "A foltod egyelőre csak az a kék sarok. Kattints a mellette lévő **piros** mezőre: a folt piros lesz, és minden hozzá érő piros mező is vele jön."
      },
      "step3": {
        "text": "Most kattints egy **kék** mezőre a foltod szélén. Egy jól választott szín egyetlen lépéssel messzire szétterjedhet a rácson."
      },
      "step4": {
        "text": "A foltodon kívül már csak a **zöld** maradt. Még egy kattintás, és a rács többi része is beolvad."
      },
      "step5": {
        "text": "Négyből három lépés — az állapotsor számolja őket. Ha elfogynak, mielőtt a rács egyszínű lenne, elvesztetted a kört. Elakadtál? A **Tipp** lejátszik helyetted egy jó színt, a **Megoldás** pedig automatikusan befejezi a rácsot."
      }
    },
    "galaxies": {
      "step1": {
        "text": "Két pont, tehát két galaxis. Rajzolj falakat a rácsvonalak mentén úgy, hogy minden pont a saját tartománya közepére kerüljön: ha a tartományt 180°-kal elforgatod a pontja körül, pontosan önmagára kell esnie."
      },
      "step2": {
        "text": "A bal oldali pont két mező közötti vonalon ül, így a galaxisa csak a két bal oldali oszlop lehet. **Kattints** a tőlük jobbra futó rácsvonalra, a **felső sorban**."
      },
      "step3": {
        "text": "A pontokkal jegyzetelni is lehet. **Húzz** a jobb oldali pontból a **jobb felső mezőbe**, hogy nyilat hagyj ott: ezzel jelölöd, hogy az a mező a galaxisához tartozik."
      },
      "step4": {
        "text": "Vissza a falhoz: **kattints** ugyanarra a rácsvonalra egy sorral lejjebb, a **középső sorban**."
      },
      "step5": {
        "text": "Egy szakasz maradt, az **alsó sorban**. **Kattints** rá, és mindkét galaxis bezárul."
      },
      "step6": {
        "text": "Mindkét tartomány árnyékolt, tehát mindkettő helyes. A **Megoldás** kirajzolja a teljes választ, egy falra kattintva pedig újra letörlöd."
      }
    },
    "guess": {
      "step1": {
        "text": "A kérdőjelek mögött két bábu rejtőzik, három szín valamilyen sorrendjében. Tippelj egy sort, olvasd le a rá kapott jeleket, és szűkítsd a kört."
      },
      "step2": {
        "text": "**Húzd** ki a legfelső színt a tálcáról, és ejtsd a nyíllal jelölt sor **bal oldali lyukába**."
      },
      "step3": {
        "text": "Előbb színt is választhatsz, és azzal kattinthatsz a lyukakra. Kattints a tálca **második színére**."
      },
      "step4": {
        "text": "Most kattints a **jobb oldali lyukra**, hogy beejtsd azt a színt."
      },
      "step5": {
        "text": "A sor tele van, így a jobb oldalán álló **szaggatott doboz** kigyullad. Kattints rá, és a játék kiértékeli a tippedet."
      },
      "step6": {
        "text": "Két **üres** jel azt jelenti, hogy mindkét szín szerepel a válaszban, de egyik sincs a helyén — a tömör jel jó színt és jó helyet jelentene. Cseréld meg őket, és küldd be újra."
      },
      "step7": {
        "text": "Megoldva. A **Megoldás** feladja és megmutatja a választ, az **L** billentyű pedig betűkkel jelöli a bábukat, ha nehéz megkülönböztetni a színeket.",
        "textTouch": "Megoldva. A **Megoldás** feladja és megmutatja a választ, a Vissza melletti **Megtartás** pedig a helyén tartja azt a bábut, amelyben biztos vagy, a következő tippedhez."
      }
    },
    "inertia": {
      "step1": {
        "text": "Te vagy a bal felső sarokban lévő golyó, és **három drágakövet** kell összeszedned. Ha a golyó egyszer elindul, csak falnál vagy megállítónál áll meg — az akna pedig végez vele."
      },
      "step2": {
        "text": "Kattints egy mezőre a golyótól **jobbra**. Arra gurul, amíg a tábla széle meg nem állítja, és útközben felsöpri a drágakövet."
      },
      "step3": {
        "text": "Most kattints a golyó **alá**. Felszedi a következő drágakövet, és a két mezővel lejjebb lévő szaggatott gyűrű — egy megállító — megállítja."
      },
      "step4": {
        "text": "Vigyázz: a golyó alatt közvetlenül álló tüskés valami egy **akna**. Ha ráhajtasz, vége a játéknak, és csak a **Vissza** segít ki belőle."
      },
      "step5": {
        "text": "Menj inkább **átlósan**: kattints a két mezővel lejjebb és két mezővel balra lévő mezőre, és a golyó elcsúszik az akna mellett az utolsó drágakőre."
      },
      "step6": {
        "text": "Mindhárom drágakő megvan. A **Vissza** visszatekeri az elrontott gurulást; a nyílbillentyűk egyenesen, a Home, Page Up, End és Page Down pedig átlósan gurítanak.",
        "textTouch": "Mindhárom drágakő megvan. A **Vissza** visszatekeri az elrontott gurulást, és a rácson kívülre koppintás is működik, ami sokat segít, ha a golyó a szélnek támaszkodik."
      }
    },
    "keen": {
      "step1": {
        "text": "Írd be az 1-est, 2-est és 3-ast úgy, hogy mindegyik pontosan egyszer szerepeljen minden sorban és oszlopban, és hogy minden vastagon keretezett ketrecben kijöjjön a megadott eredmény."
      },
      "step2": {
        "text": "A **2×** ketrec szorzata 2, tehát a számjegyei 1, 1 és 2. Egy ketrecben ismétlődhet számjegy, sorban vagy oszlopban viszont nem, így a 2-es a sarokba való: kattints arra a mezőre, és írd be a **2**-est.",
        "textTouch": "A **2×** ketrec szorzata 2, tehát a számjegyei 1, 1 és 2. A 2-es a sarokba való: koppints arra a mezőre, majd a billentyűk közül a **2**-esre."
      },
      "step3": {
        "text": "A ketrec másik két mezőjében az 1-esek állnak. Kattints a **2-estől jobbra** lévő mezőre, és írd be az **1**-est.",
        "textTouch": "A ketrec másik két mezőjében az 1-esek állnak. Koppints a **2-estől jobbra** lévő mezőre, majd a billentyűsoron az **1**-esre."
      },
      "step4": {
        "text": "A felső sorban már megvan a 2-es és az 1-es, tehát az utolsó mezőjében a 3-asnak kell állnia. Kattints a **jobb felső mezőre**, és írd be a **3**-ast.",
        "textTouch": "A felső sorban már megvan a 2-es és az 1-es, tehát az utolsó mezőjében a 3-asnak kell állnia. Koppints a **jobb felső mezőre**, majd a billentyűsoron a **3**-asra."
      },
      "step5": {
        "text": "Csak tippelsz egy mezőnél? **Kattints jobb gombbal** a középső mezőre, és írd be a **3**-ast: így a számjegy ceruzajelként, jegyzetként kerül be, nem valódi válaszként.",
        "textTouch": "Csak tippelsz egy mezőnél? **Koppints hosszan** a középső mezőre, és koppints a **3**-asra: így a számjegy jegyzetként kerül be, nem kitöltésként. A **✎** gomb ugyanezt teszi azzal a mezővel, amelyre koppintottál."
      },
      "step6": {
        "text": "A többit ugyanígy fejtsd ki; a sorában vagy oszlopában ismétlődő számjegy pirosra vált, és így jár a tele ketrec is, amelyikben nem jön ki az eredmény. A szünetmenüben a **Jelek** minden lehetőséget beceruzáz helyetted, a **Megoldás** pedig elárulja a választ."
      }
    },
    "lightup": {
      "step1": {
        "text": "Minden fehér mezőnek világosnak kell lennie a végén. Egy izzó a saját sorát és oszlopát világítja meg, amíg egy fekete mező el nem zárja a fényt, és egyik izzó sem állhat egy másik fényében."
      },
      "step2": {
        "text": "A szám azt mondja meg, hány izzó érinti azt a fekete mezőt. Ennek a **2**-esnek csak két fehér szomszédja van, tehát mindkettőben izzó áll: kattints a **jobb oldalira**."
      },
      "step3": {
        "text": "Figyeld, ahogy a sárga fény végigfut a sugár mentén. Most kattints a 2-es **alatti** mezőre a második izzóért."
      },
      "step4": {
        "text": "A **0**-t egyetlen izzó sem érinti. **Kattints jobb gombbal** a fölötte lévő mezőre, hogy keresztet ceruzázz be: ez csak emlékeztet, hogy oda nem kerülhet izzó."
      },
      "step5": {
        "text": "Az **1**-es pontosan egy izzót kér. Az alatta lévő mező már világos, tehát az ott álló izzó a fénybe kerülne — kattints inkább az 1-estől **balra** lévő mezőre."
      },
      "step6": {
        "text": "A felső sorban még két mező sötét, és az egyiket már kihúztad. Kattints a **másikra**."
      },
      "step7": {
        "text": "Minden mező világos, minden szám elégedett. A **Vissza** visszavesz egy izzót, a nyílbillentyűk pedig az Enterrel és a Space-szel billentyűzetről raknak le izzót és keresztet.",
        "textTouch": "Minden mező világos, minden szám elégedett. A **Vissza** visszavesz egy izzót, a hosszú koppintás pedig kihúzza azokat a mezőket, amelyeket kizártál."
      }
    },
    "loopy": {
      "step1": {
        "text": "Rajzolj **egyetlen** zárt hurkot a pontok közötti halvány vonalak mentén. Minden szám megmondja, hogy a mezője négy oldala közül hányat használ a hurok."
      },
      "step2": {
        "text": "A középső mező **4**-es, tehát mind a négy oldala a hurok része. **Kattints** a felső oldalára, és megrajzolod az első vonalat."
      },
      "step3": {
        "text": "Most a **bal oldalára**. Ha újra egy vonalra kattintasz, letörlöd."
      },
      "step4": {
        "text": "Minden pontból két vonal indul, vagy egy sem, és az a pont, ahol ez a kettő találkozik, betelt. **Kattints jobb gombbal** a belőle felfelé futó vonalra, hogy használhatatlanként kihúzd."
      },
      "step5": {
        "text": "Két oldal maradt. **Kattints** a középső mező alsó oldalára."
      },
      "step6": {
        "text": "A **jobb oldal** pedig lezárja. Egyetlen hurok, sehol egy laza vég, és a négy **0** mellett nem fut vonal."
      },
      "step7": {
        "text": "Megoldva. A **Vissza** visszalépked a vonalaidon, a szünetmenü **Típus** gombja pedig háromszögekre, hatszögekre és furcsább csempézésekre cseréli a négyzeteket."
      }
    },
    "magnets": {
      "step1": {
        "text": "Minden dominó vagy mágnes — egy **+** és egy **−** féllel —, vagy üres lap. A számok az egyes sorok és oszlopok **+** pólusait (fent és balra), illetve **−** pólusait (lent és jobbra) számolják, és azonos pólusok soha nem érhetnek össze."
      },
      "step2": {
        "text": "Az alsó sor három **−** pólust kér, és csak három dominó ér bele, tehát mindegyiknek adnia kell egyet. **Kattints** az álló dominó felső felére, hogy az **+** legyen, a **−** pedig lecsússzon az alsó sorba."
      },
      "step3": {
        "text": "Így a jobb alsó fekvő dominó is mágnes, az utolsó oszlop fölötti **0** pedig megtiltja ott a **+**-t. **Kattints** a bal felére, hogy a **+** arra az oldalra kerüljön."
      },
      "step4": {
        "text": "A negyedik oszlopnak most megvan az egy **+**-a, és egyáltalán nem kér **−**-t, tehát a fölötte lévő dominó egyik sem lehet. **Kattints rá jobb gombbal**, hogy üresnek jelöld."
      },
      "step5": {
        "text": "A felső sornak még kell egy **+** és egy **−** a bal oldali fekvő dominótól. A jobb fele egy **+**-hoz ér, azonos pólusok pedig nem érintkezhetnek — tehát **kattints** a bal felére."
      },
      "step6": {
        "text": "Egy dominó maradt. Az első oszlop már elhasználta a **+**-át fent, tehát itt a **+** a jobb oldalra való: **kattints** a jobb felére, és kész."
      },
      "step7": {
        "text": "Megoldva! Ha újra ugyanarra a félre kattintasz, megfordul a mágnes; a második jobb gombos kattintás kérdőjeleket hagy — „mágnes, de melyik irányban?” —, a **Vissza** pedig visszalépked."
      }
    },
    "map": {
      "step1": {
        "text": "Színezz ki minden tartományt úgy, hogy két közös határszakaszon osztozó tartomány soha ne legyen azonos színű. Négy szín mindig elég, és itt még három tartomány üres."
      },
      "step2": {
        "text": "Előbb vegyél fel egy színt: **kattints** a **kék mintára**, a térkép alatti sor másodikjára."
      },
      "step3": {
        "text": "Ha van szín a kezedben, egy üres tartományon a **jobb gombos kattintás** beceruzáz belőle egy pöttyöt — ez jegyzet arról, hogy a tartomány *talán* olyan színű. Próbáld ki a jobb oldalon végigfutó magas tartományon."
      },
      "step4": {
        "text": "Ez több mint talán: az a tartomány már határos a pirossal, a zölddel és a sárgával, tehát csak a kék marad. **Kattints** rá, és kifested."
      },
      "step5": {
        "text": "Egy színt **húzással** is átvihetsz egyik tartományból a másikba. A felül végigfutó nagy tartomány most a pirossal, a zölddel és a kékkel érintkezik, tehát **húzd** fel rá a sárgát az alul lévő kis tartományból."
      },
      "step6": {
        "text": "Egy üres maradt, a **bal alsó sarokban**: a zölddel, a kékkel és azzal az új sárgával határos, tehát csak piros lehet. **Húzd** rá a pirosat a jobb felső sarokban lévő tartományból."
      },
      "step7": {
        "text": "Kész — ütközésnél piros **!** jelent volna meg a két tartomány határán. A **Vissza** visszalépked, a nyílbillentyűk pedig az **1**–**4** gombokkal billentyűzetről színeznek.",
        "textTouch": "Kész — ütközésnél piros **!** jelent volna meg a két tartomány határán. A **Vissza** visszalépked, a sor végén lévő radír minta pedig letörli azt a tartományt, amelyiknél meggondoltad magad."
      }
    },
    "mines": {
      "step1": {
        "text": "Minden szám a körülötte lévő nyolc mezőben rejtőző aknákat számolja. A letakart tömb alatt két akna lapul; fedd fel az összes többi mezőt úgy, hogy egyikre se lépj rá."
      },
      "step2": {
        "text": "Ez az **1**-es csak egyetlen letakart mezőhöz ér, tehát az a mező akna. **Kattints rá jobb gombbal**, és tűzz ki egy zászlót."
      },
      "step3": {
        "text": "Az alatta lévő **1**-es egyetlen aknája már meg van jelölve, tehát a többi szomszédja biztonságos. **Kattints arra az 1-esre**, és egyszerre felnyitod őket."
      },
      "step4": {
        "text": "A tömb fölötti **2**-es már egy zászlót számol, és egyetlen letakart mezője maradt. **Kattints jobb gombbal** arra a mezőre."
      },
      "step5": {
        "text": "Mindkét akna meg van jelölve, tehát az utolsó letakart mező biztosan tiszta. **Kattints** rá, és kész a rács."
      },
      "step6": {
        "text": "Tiszta a terep! A második jobb gombos kattintás leveszi a zászlót, a **Vissza** pedig kiment, ha mégis aknára lépnél."
      }
    },
    "net": {
      "step1": {
        "text": "Minden lapkán van egy darab vezeték, és az egész hálózatot véletlenszerűen megforgatták. Forgasd a lapkákat, amíg mind a kilenc a középen megjelölt lapkáról nem lóg: a **kék** vezetékek már élnek, a szürkék nem."
      },
      "step2": {
        "text": "A bal alsó lapka vezetéke egyenesen a falnak áll. **Kattints** rá egy negyed fordulatért az óramutató járásával ellentétesen, így a vezeték eléri a jobb oldali szomszédját."
      },
      "step3": {
        "text": "A **jobb gombos kattintás** a másik irányba forgat. Fordítsd el a jobb alsó lapkát egyszer az óramutató járása szerint, és a vezetéke balra fordul."
      },
      "step4": {
        "text": "A középső lapkán mind a négy oldalon van vezeték, tehát nem lehet rossz. **Kattints rá a középső gombbal**, vagy kapcsold be a Vissza melletti **lakatot**, és kattints rá, hogy rögzítsd: a rögzített lapka árnyékolt, és nem forog.",
        "textTouch": "A középső lapkán mind a négy oldalon van vezeték, tehát nem lehet rossz. Kapcsold be a Vissza melletti **lakatot**, és koppints a lapkára, hogy rögzítsd: a rögzített lapka árnyékolt, és nem forog."
      },
      "step5": {
        "text": "Egy lapka maradt. Kikapcsolt **lakattal** **kattints** a jobb felső sarokra, hogy a vezetéke balra forduljon, és az egész hálózat kigyulladjon.",
        "textTouch": "Egy lapka maradt. Kikapcsolt **lakattal** koppints a jobb felső sarokra, hogy a vezetéke balra forduljon, és az egész hálózat kigyulladjon."
      },
      "step6": {
        "text": "Mind a kilenc lapka él. A **Vissza** visszalépked a fordulataidon; billentyűzetről a nyílbillentyűk mozgatják a kurzort, az **A**, a **D** és az **F** pedig forgatja alatta a lapkát.",
        "textTouch": "Mind a kilenc lapka él. A **Vissza** visszalépked a fordulataidon, a biztosra vett lapka rögzítése megvédi egy elkószált koppintástól, a **Keverés** pedig újra megpörget minden nem rögzített lapkát."
      }
    },
    "netslide": {
      "step1": {
        "text": "Minden vezetékdarabnak az áramforráshoz kell kapcsolódnia a végén. A kék vezetékek élnek, a szürke ceruzásak nem."
      },
      "step2": {
        "text": "Az áramforrás a középső lapkán ül. Az a lapka soha nem mozdul, ezért a középső sorban és oszlopban nincsenek nyilak — minden más körbecsúsztatható."
      },
      "step3": {
        "text": "Kattints az **alsó sortól balra** lévő nyílra, hogy a sort egy lépéssel balra told; a lecsúszó vezeték jobb oldalt bukkan fel újra."
      },
      "step4": {
        "text": "Az alsó sor most összeáll, de még szürke: semmi sem köti felfelé az áramforráshoz."
      },
      "step5": {
        "text": "**Kattints jobb gombbal** a **harmadik oszlop fölötti** nyílra. A jobb gombos kattintás megfordítja a nyilat, így az oszlop lefelé csúszik, és az utolsó vezetékek is kigyulladnak."
      },
      "step6": {
        "text": "Minden él! A **Megoldás** mutat egy megoldást, ha elakadsz, a **Típus** menüben pedig körbeérő rácsok is vannak, ahol a vezetékek az egyik szélen kifutva a másikon jönnek vissza."
      }
    },
    "pattern": {
      "step1": {
        "text": "A sorok és oszlopok mellett álló számok a fekete blokkjaik hosszai, sorrendben. Fejtsd ki, mely mezők feketék, és töltsd ki őket."
      },
      "step2": {
        "text": "A **harmadik oszlop** 1 2-t mond: egy fekete, egy hézag, majd két fekete. Négy mezőben ez csak egyféleképpen fér el, a párossal alul. **Húzz** végig rajtuk lefelé."
      },
      "step3": {
        "text": "Így a páros fölötti mező lesz a hézag. **Kattints rá jobb gombbal** egy pöttyért: ezzel jelölöd azt a mezőt, amelyikről tudod, hogy fehér."
      },
      "step4": {
        "text": "Az oszlop legfelső mezője pedig a nyom magányos feketéje. **Kattints** rá."
      },
      "step5": {
        "text": "Az **utolsó oszlop** 3-at mond. Négy mezőben egy hármas blokk bárhol álljon is, mindig lefedi a középső kettőt, tehát **húzz** végig azokon."
      },
      "step6": {
        "text": "A nyom szürkére vált, amint a sora kész. Csipegesd tovább ugyanígy, vagy hagyd, hogy a **Megoldás** fejezze be ezt; a középső gombos kattintás visszaállít egy mezőt ismeretlenre."
      }
    },
    "pearl": {
      "step1": {
        "text": "Rajzolj egyetlen zárt hurkot mezőközépről mezőközépre. Nem kell minden mezőt érintenie, de minden gyöngyön át kell haladnia."
      },
      "step2": {
        "text": "A **fehér gyöngy** azt jelenti, hogy a hurok egyenesen halad át rajta. A felső sorban csak oldalirányban lehet egyenes, tehát **húzz** a gyöngytől balra lévő mezőtől a tőle jobbra lévőig."
      },
      "step3": {
        "text": "Ennek a gyöngynek most megvan mindkét szakasza, tehát semmi más nem indulhat ki belőle. **Kattints jobb gombbal** az alatta lévő élre, hogy kihúzd azt az oldalt."
      },
      "step4": {
        "text": "A **fekete gyöngyben** a hurok fordul, utána pedig mindkét szomszédos mezőn egyenesen halad át. A **bal szélen** álló nem fordulhat lefelé — ahhoz egyenes vonal kellene a bal alsó sarkon át —, tehát **kattints** a jobb oldali élére."
      },
      "step5": {
        "text": "Így a mellette lévő mezőn egyenesen fut tovább — és a mögötte lévő fehér gyöngyön is. **Húzz** attól a mezőtől a negyedik oszlopig."
      },
      "step6": {
        "text": "Dolgozz tovább a gyöngyökből kiindulva; a gyöngy piros glóriát kap abban a pillanatban, amikor a szabálya sérül. A **Megoldás** kirajzolja az egész hurkot, ha látni akarod."
      }
    },
    "pegs": {
      "step1": {
        "text": "Egy bábu átugorja a szomszédját a mögötte lévő üres lyukba, az átugrott bábut pedig leszedjük. Tisztítsd le ezt a kis táblát **egyetlen bábuig**: három ugrás."
      },
      "step2": {
        "text": "**Húzd** a szár tetején álló bábut lefelé, a szomszédján át az alul lévő lyukba."
      },
      "step3": {
        "text": "Kattintással is megy. Kattints a **jobb oldali bábura**, hogy felvedd, majd a tőle két mezővel balra lévő lyukra."
      },
      "step4": {
        "text": "Utolsó ugrás: húzd a **bal alsó sarokban** álló bábut a szomszédján át középre."
      },
      "step5": {
        "text": "Egy bábu maradt — megoldva. A **Vissza** visszavon egy ugrást, ha zsákutcába jutottál, és a nyílbillentyűk is működnek: az Enter felveszi a bábut, egy nyíl pedig meglöki.",
        "textTouch": "Egy bábu maradt — megoldva. A **Vissza** annyi ugrást von vissza, amennyit csak akarsz, valahányszor zsákutcába jutsz."
      }
    },
    "range": {
      "step1": {
        "text": "Feketíts be mezőket úgy, hogy minden szám pontosan annyi fehér mezőt lásson a saját mezőjéből: önmagát, plusz minden mezőt fel, le, balra és jobbra, amíg egy fekete mező vagy a tábla széle meg nem állítja."
      },
      "step2": {
        "text": "A **6**-os most hat mezőt lát — az egész sorát és az alatta lévő két mezőt. Tehát abban a sorban és oszlopban semmi sem lehet fekete."
      },
      "step3": {
        "text": "A **2**-es csak önmagát és még egy mezőt láthatja, a fölötte lévő mezőnek pedig fehérnek kell maradnia a 6-os miatt. Ezért **kattints** a tőle balra lévő mezőre, és feketítsd be."
      },
      "step4": {
        "text": "Így a jobb felső mező marad az egyetlen fehér mező, amelyet a 2-es még lát. **Kattints rá jobb gombbal** egy ceruzapöttyért: így jelölöd azt a mezőt, amelyikről tudod, hogy fehér marad."
      },
      "step5": {
        "text": "A **3**-as már látja önmagát és a tőle balra lévő két mezőt, tehát a jobbra lévő mezőnek feketének kell lennie. **Kattints** rá."
      },
      "step6": {
        "text": "Két fekete mezővel kész — a pöttyök csak jegyzetek. A **H** kitölt egy mezőt, amely a többiből következik, a **Megoldás** pedig az egész rácsot kipöttyözi.",
        "textTouch": "Két fekete mezővel kész — a pöttyök csak jegyzetek. A **Megoldás** az egész rácsot kipöttyözi, ha inkább látnád a választ."
      }
    },
    "rect": {
      "step1": {
        "text": "Vágd fel ezt a rácsot téglalapokra úgy, hogy minden téglalapban pontosan egy szám álljon, és az a szám adja meg, hány mezőt fed a téglalap."
      },
      "step2": {
        "text": "Egy téglalapban csak egy szám állhat, és a **3**-as közvetlenül a **4**-es alatt ül — tehát a 4-esnek az egész felső sort el kell foglalnia. **Húzz** a 4-estől a sor jobb szélső mezőjéig."
      },
      "step3": {
        "text": "Egyetlen rácsvonalra kattintva pontosan azt az egy élt teszed hozzá vagy veszed le. **Kattints** a **3**-astól jobbra futó vonalra."
      },
      "step4": {
        "text": "A 9-es csak 3×3-as blokk lehet, és egyetlen hely maradt neki. **Húzz** végig a kiemelt blokkon, a bal felső mezőjétől a jobb alsó sarkáig: ezzel a 3-ast is bekeríted."
      },
      "step5": {
        "text": "Minden mező a megfelelő méretű téglalapban van. Ha **jobb gombbal húzol**, letörlöd egy terület belső vonalait, de a körvonala megmarad; a **Vissza** pedig visszavon egy húzást."
      }
    },
    "samegame": {
      "step1": {
        "text": "Ürítsd ki a táblát: vegyél le két vagy több egymáshoz érő, azonos színű mezőből álló csoportokat. Egy _n_ mezős csoport (_n_ − 2)² pontot ér, tehát a nagyok számítanak igazán."
      },
      "step2": {
        "text": "Kattints a felül sorakozó négy **piros** mező bármelyikére. Az első kattintás csak kijelöli a csoportot: kivilágosodik, és vastag körvonalat kap."
      },
      "step3": {
        "text": "Kattints újra a kijelölt csoportra, hogy leemeld a tábláról, és négy pontot szerezz. A rés fölötti mezők beleesnek, az üres oszlop pedig maga mellé húzza a szomszédait."
      },
      "step4": {
        "text": "Ez a **zöld** mező magában áll. Semmi mellette nem azonos színű, tehát nem lehet kijelölni — várnia kell, amíg a tábla mozgása mellé sodor egy társat."
      },
      "step5": {
        "text": "Most az itt kiemelt **kék pár**. Kattints a két mező bármelyikére, és mindkettőt kijelölöd."
      },
      "step6": {
        "text": "Meggondoltad magad? **Kattints jobb gombbal** a kijelölésre, és elengeded — semmi nem tűnik el, amíg másodszor is rá nem kattintasz."
      },
      "step7": {
        "text": "Ennyi az egész játék. Minden tábla kiüríthető, úgyhogy csak tovább — a **Vissza** visszatekeri, ha magára hagysz egy mezőt, és nincs Megoldás gomb, ami kimentene."
      }
    },
    "signpost": {
      "step1": {
        "text": "Minden mezőn van egy nyíl. Fűzd mind a hatot egyetlen, **1-től 6-ig** számozott láncba, amelyben minden mezőt olyan mező követ, amely a saját nyila mentén fekszik valahol."
      },
      "step2": {
        "text": "Az **1**-es kelet felé mutat. **Húzz** róla a tőle jobbra lévő mezőre, hogy az legyen a 2-es."
      },
      "step3": {
        "text": "A **3**-as magától kapcsolódott, ahogy az egymást követő, jó irányba mutató számok mindig. Most **húzd** a jobb alsó mezőt a tőle balra lévőre."
      },
      "step4": {
        "text": "Egyiküknek sincs még száma, ezért a pár **a** és **a+1** jelölést kap. **Kattints jobb gombbal** az alsó sor középső mezőjére, hogy újra szétválaszd őket."
      },
      "step5": {
        "text": "A valódi számok jobbak: **húzd** a **3**-ast az alatta lévő mezőre, amiből 4-es lesz."
      },
      "step6": {
        "text": "Utolsó láncszem: **húzd** azt a 4-est a tőle balra lévő mezőre. Abból 5-ös lesz, a 6-os pedig magától zárja az útvonalat."
      },
      "step7": {
        "text": "Megoldva. Ha **jobb gombbal húzol**, a másik irányba kapcsolsz — egy mezőről az előtte állóra —, a **Megoldás** pedig kirakja a teljes útvonalat."
      }
    },
    "singles": {
      "step1": {
        "text": "Sötétíts el mezőket, amíg egyetlen sor vagy oszlop fehér mezői között sem ismétlődik szám. Két fekete mezőnek soha nem lehet közös éle, a fehér mezőknek pedig egyetlen összefüggő tartományt kell alkotniuk."
      },
      "step2": {
        "text": "Ebben a sorban a két **4**-es között egy mező van. Ha azt a mezőt elsötétítenéd, mindkét 4-es fehér maradna, tehát neki magának kell fehérnek lennie — **kattints rá jobb gombbal**, hogy bekarikázd."
      },
      "step3": {
        "text": "Az a bekarikázott **3**-as véglegesen fehér, az oszlopában pedig fent van egy másik 3-as. **Kattints** a felsőre, hogy elsötétítsd."
      },
      "step4": {
        "text": "A fekete mezők soha nem érnek össze, tehát a tőle jobbra lévő **4**-es fehér marad. **Kattints** az utolsó oszlop másik 4-esére."
      },
      "step5": {
        "text": "Ugyanez újra: az új fekete meződ fölött közvetlenül álló **2**-es fehér, a sorában pedig bal szélen van egy másik 2-es. **Kattints** arra."
      },
      "step6": {
        "text": "Egy maradt. A fekete mező fölötti **3**-as fehér, tehát az oszlop alján álló másik 3-asnak mennie kell. **Kattints** rá."
      },
      "step7": {
        "text": "Megoldva, és a fehér mezők továbbra is összefüggnek. A karikák csak jegyzetek, a **Vissza** pedig végigsétál visszafelé a lépéseiden."
      }
    },
    "sixteen": {
      "step1": {
        "text": "Rakd sorrendbe a lapkákat, **1-től 9-ig**, balról jobbra olvasva. A szélen lévő nyilak egy egész sort vagy oszlopot tolnak egy lépéssel, és ami lecsúszik, a túloldalon jön vissza."
      },
      "step2": {
        "text": "Kattints a **második oszlop fölötti** nyílra, hogy az oszlopot egy lépéssel feljebb told; ezzel kész a középső sor."
      },
      "step3": {
        "text": "Most az alsó sort kell jobbra tolni. **Kattints jobb gombbal** az **alsó sortól balra** lévő nyílra: a jobb gombos kattintás az ellenkező irányba küldi a sort."
      },
      "step4": {
        "text": "Az utolsó: kattints a **felső sortól balra** lévő nyílra, hogy balra told, és kész a rács."
      },
      "step5": {
        "text": "Sorrendben! A szünetmenü **Típus** listájában nagyobb rácsok is vannak, az **Egyéni…** pedig megadott számú keverőlépéssel össze is kever neked egy rácsot, hogy visszacsináld."
      }
    },
    "slant": {
      "step1": {
        "text": "Húzz egy átlót minden mezőn keresztül. A bekarikázott szám a sarkát érintő vonalakat számolja, és a vonalak soha nem zárhatnak hurkot."
      },
      "step2": {
        "text": "A bal felső sarokban álló **0** nem tűr maga mellett vonalat, tehát az egyetlen mezőjének a másik irányba kell dőlnie. **Kattints jobb gombbal** arra a mezőre, és rajzolsz egy `/` jelet."
      },
      "step3": {
        "text": "A **4**-eshez mind a négy körülötte lévő mezőből vonal kell. **Kattints** a fölötte és tőle balra lévőre — a kattintás `\\` jelet rajzol."
      },
      "step4": {
        "text": "A **4**-es fölött és tőle jobbra lévő mezőnek viszont balra lefelé kell dőlnie. **Kattints rá jobb gombbal** egy `/` jelért."
      },
      "step5": {
        "text": "A bal szélen álló **1**-esnek már megvan az egyetlen vonala, az alatta lévő mezőből. Tehát a fölötte lévő mezőnek el kell dőlnie tőle: **kattints** rá egy `\\` jelért."
      },
      "step6": {
        "text": "Folytasd ugyanígy. Az a szám, amely már nem jöhet ki, pirosra vált, és így jár minden vonal is, amely zárt hurokba került. A szünetmenü **Megoldás** gombja kitölti a többit."
      }
    },
    "solo": {
      "step1": {
        "text": "Minden sorban, minden oszlopban és minden bekeretezett **2×2-es blokkban** pontosan egyszer kell szerepelnie az 1-esnek, 2-esnek, 3-asnak és 4-esnek. Ezen a kis rácson három mező hiányzik."
      },
      "step2": {
        "text": "Ebben a **blokkban** már van 2-es, 3-as és 4-es, tehát az üres mezőjébe csak **1**-es kerülhet. Kattints arra a mezőre, és nyomd meg az **1**-es billentyűt.",
        "textTouch": "Ebben a **blokkban** már van 2-es, 3-as és 4-es, tehát az üres mezőjébe csak **1**-es kerülhet. Koppints arra a mezőre, majd a billentyűk közül az **1**-esre."
      },
      "step3": {
        "text": "Nem vagy biztos egy mezőben? **Kattints jobb gombbal** erre az üresre, és nyomd meg a **2**-est, hogy jegyzetként ceruzázd be a számjegyet.",
        "textTouch": "Nem vagy biztos egy mezőben? Koppints erre az üresre, rögzítsd a billentyűsoron a **✎** gombot, és koppints a **2**-esre, hogy jegyzetként kerüljön be a számjegy."
      },
      "step4": {
        "text": "A sorában már ott a 3-as, a 4-es és az 1-es, tehát a jegyzet jó volt. **Kattints** ugyanarra a mezőre, és nyomd meg a **2**-est, hogy beírd a választ.",
        "textTouch": "A sorában már ott a 3-as, a 4-es és az 1-es, tehát a jegyzet jó volt. A mező még ki van választva, úgyhogy koppints a **✎** gombra, hogy kikapcsold a ceruzát, majd a **2**-esre, hogy beírd a választ."
      },
      "step5": {
        "text": "Egy mező maradt. A sorában már ott a 4-es, a 3-as és az 1-es — kattints rá, és nyomd meg a hiányzó számjegyet.",
        "textTouch": "Egy mező maradt. A sorában már ott a 4-es, a 3-as és az 1-es — koppints rá, majd a billentyűsoron a hiányzó számjegyre."
      },
      "step6": {
        "text": "Megoldva! A **Vissza** visszavon egy rossz számjegyet, az **M** billentyű pedig egyszerre beceruzáz minden lehetőséget minden üres mezőbe.",
        "textTouch": "Megoldva! A **Vissza** visszavon egy rossz számjegyet, a szünetmenü **Jelek** gombja pedig egyszerre beceruzáz minden lehetőséget minden üres mezőbe."
      }
    },
    "tents": {
      "step1": {
        "text": "Verj egy sátrat minden fa mellé — fölé, alá, tőle balra vagy jobbra, átlósan soha. Két sátor nem érhet össze, a számok pedig a sorokban és oszlopokban álló sátrakat számolják."
      },
      "step2": {
        "text": "A második sor végén álló **0** azt jelenti, hogy abba a sorba nem kerül sátor. **Kattints jobb gombbal** a fa melletti mezőre, hogy fűnek jelöld."
      },
      "step3": {
        "text": "A harmadik oszlop is üres. **Jobb gombbal húzz** a legfelső mezőjétől a harmadik sorig, hogy egyszerre mind a hármat befüvesítsd."
      },
      "step4": {
        "text": "A jobb alsó fa a sarokban áll, mellette egy másik fa, tehát az egyetlen szabad szomszédja fölötte van. **Kattints** arra a mezőre, és verj oda sátrat."
      },
      "step5": {
        "text": "Az a sátor betölti a harmadik sort, tehát a bal szélen álló fa sátra sem kerülhet a fa alá. **Kattints** a bal felső mezőre."
      },
      "step6": {
        "text": "Egy fának még nincs sátra, és csak a tőle balra lévő mező szabad. **Kattints** rá, és kész a tábor."
      },
      "step7": {
        "text": "Megoldva! Ha újra egy sátorra vagy fűjelre kattintasz, letörlöd; a nyílbillentyűk az Enterrel és a Space-szel ugyanezt teszik, a **Vissza** pedig visszalépked.",
        "textTouch": "Megoldva! Ha újra egy sátorra vagy fűjelre koppintasz, letörlöd, a **Vissza** pedig visszalépked."
      }
    },
    "towers": {
      "step1": {
        "text": "Minden sorban és oszlopban egy-egy torony áll minden magasságból, 1-től 4-ig. A szélen álló szám azt számolja, hány tornyot **látsz** onnan: a magasabb torony minden mögötte álló alacsonyabbat eltakar."
      },
      "step2": {
        "text": "A felső sor jobb oldalán álló **1**-es azt jelenti, hogy arról az oldalról csak egy torony látszik, tehát a legközelebbinek a legmagasabbnak kell lennie. Kattints arra a mezőre, és nyomd meg a **4**-est.",
        "textTouch": "A felső sor jobb oldalán álló **1**-es azt jelenti, hogy arról az oldalról csak egy torony látszik, tehát a legközelebbinek a legmagasabbnak kell lennie. Koppints arra a mezőre, majd a billentyűk közül a **4**-esre."
      },
      "step3": {
        "text": "Válasz helyett le is jegyezheted a lehetőségeket. **Kattints jobb gombbal** a felső sor bal szélén álló üres mezőre, és nyomd meg az **1**-est.",
        "textTouch": "Válasz helyett le is jegyezheted a lehetőségeket. Koppints a felső sor bal szélén álló üres mezőre, rögzítsd a billentyűsoron a **✎** gombot, és koppints az **1**-esre."
      },
      "step4": {
        "text": "A sor bal oldalán álló **4**-es azt mondja, mind a négy torony látszik, tehát arról a végről 1-2-3-4 sorrendben emelkednek. **Kattints** a mezőre, és nyomd meg az **1**-est a válaszhoz.",
        "textTouch": "A sor bal oldalán álló **4**-es azt mondja, mind a négy torony látszik, tehát arról a végről 1-2-3-4 sorrendben emelkednek. A mező még ki van választva, úgyhogy koppints a **✎** gombra, hogy kikapcsold a ceruzát, majd az **1**-esre a válaszhoz."
      },
      "step5": {
        "text": "Egy mező maradt, és a sora mellett álló **1**-es megint a legmagasabb tornyot teszi legközelebb. Kattints rá, és nyomd meg a **4**-est.",
        "textTouch": "Egy mező maradt, és a sora mellett álló **1**-es megint a legmagasabb tornyot teszi legközelebb. Koppints rá, majd a billentyűsoron a **4**-esre."
      },
      "step6": {
        "text": "Megoldva! A **Backspace** kiüríti az elrontott mezőt, a szünetmenü **Megoldás** gombja pedig befejezi a rejtvényt, ha az kifogott rajtad.",
        "textTouch": "Megoldva! A billentyűsoron a **⌫** kiüríti az elrontott mezőt. A szünetmenüben a **Jelek** minden lehetőséget beceruzáz, a **Megoldás** pedig befejezi a rejtvényt, ha az kifogott rajtad."
      }
    },
    "tracks": {
      "step1": {
        "text": "Egyetlen vasútvonal fut a bal oldali bejárattól az alsó kijáratig, és minden érintett mezőn pontosan két sín van. A számok megmondják, hány mezőn halad át a vonal az adott oszlopban vagy sorban."
      },
      "step2": {
        "text": "A bejárati elem már felfut a **bal felső mezőbe**, annak a mezőnek pedig a felső és a bal oldala a rács széle. Tehát a második síndarabjának jobbra kell mennie: **kattints** kicsivel a közepétől jobbra."
      },
      "step3": {
        "text": "A **bal oszlop** száma **2**, és a bejárat már mindkét mezőt használja, tehát az alsó felén nem fut semmi. **Kattints jobb gombbal** egy mező közepére, hogy kihúzd — ha **jobb gombbal húzol**, egy egész szakaszt kihúzol."
      },
      "step4": {
        "text": "A **jobb oszlop** száma **4**, tehát a vonal minden mezőjét érinti, a tetején és az alján álló mezők pedig csak befelé fordulhatnak. **Húzz** a jobb felső mezőtől végig le a jobb alsóig."
      },
      "step5": {
        "text": "Az **alsó sornak** három mező kell, és a bal oszlop kész, tehát a jobb alsó sarok a vonalon van. Nem hagyhatja el a rácsot, tehát balra és felfelé fordul: **kattints** a bal oldalára."
      },
      "step6": {
        "text": "A számok szürkére váltanak, ha a soruk rendben van, és pirosra, ha nem jöhet ki. Dolgozz tovább a laza végeknél, vagy hagyd, hogy a **Megoldás** fejezze be a vasutat."
      }
    },
    "twiddle": {
      "step1": {
        "text": "Rakd vissza a számokat sorrendbe, **1-től 9-ig**. Egy lépés négy lapkából álló négyzetes blokkot forgat negyed fordulattal; ez a tábla három fordulattal kész."
      },
      "step2": {
        "text": "Kattints a **bal felső négy lapka** közepére. A kattintás az óramutató járásával ellentétesen forgatja azt a blokkot, amitől az 1, 2, 3 a felső sorba kerül."
      },
      "step3": {
        "text": "**Kattints jobb gombbal** a **jobb alsó négy lapka** közepére, hogy azt a blokkot az óramutató járása szerint forgasd."
      },
      "step4": {
        "text": "Fejezd be egy kattintással a **bal alsó négy lapka** közepén."
      },
      "step5": {
        "text": "Kész! A **Típus** menüben nagyobb blokkok is vannak, és egy *forgásérzékeny* mód, ahol minden lapkának a megfelelő állásban is kell végeznie."
      }
    },
    "undead": {
      "step1": {
        "text": "Töltsd fel az öt üres mezőt szellemekkel, vámpírokkal és zombikkal — a fenti számláló megmondja, melyikből hány kell. Minden szám az adott irányból benézve látható szörnyeket számolja, a tükrök pedig megtörik a tekintetedet."
      },
      "step2": {
        "text": "A **felső sor bal oldaláról** benézve semmit sem látsz; a tükör ugyanezt a vonalat felül vezeti ki, ahol az **1**-es egy szörnyet lát. Csak a szellem rejtőzik el szemből, és látszik a tükörben. **Kattints** arra a mezőre."
      },
      "step3": {
        "text": "A bal alsó sarokban álló **4**-es cikcakkban halad a tükrökön át három mező mellett, és mindegyiket látja. A vámpírok eltűnnek a tükörben, tehát az egyetlen vámpír csak a bal oszlop középső mezője lehet. **Kattints** rá."
      },
      "step4": {
        "text": "A kattintás csak végiglépteti a szörnyeket. Inkább **nyomd meg a V-t**: a G, a V és a Z egyből szellemet, vámpírt vagy zombit tesz a kiemelt mezőbe.",
        "textTouch": "A koppintás egyszerre csak egyet lép a szörnyek között. Koppints inkább a billentyűk közül a **Vámpír** gombra: ez egyenesen a kiemelt mezőbe teszi azt a szörnyet."
      },
      "step5": {
        "text": "A **középső sorban** tükör nélkül, egyenesen lehet végignézni, és mindkét **1**-es egyetlen szörnyet lát — a vámpírt. Tehát a két szomszédjának szellemnek kell lennie. **Kattints** a középső mezőre."
      },
      "step6": {
        "text": "A **jobb gombos kattintás** nem tesz le semmit, hanem apró jegyzetet ceruzáz be. Próbáld ki a sor jobb oldali mezőjén; minden jobb gombos kattintás a következő szörnyet adja hozzá."
      },
      "step7": {
        "text": "Két mező maradt: a ceruzajeles a harmadik szellem, az utolsó pedig a zombi. A számok elszürkülnek, amint a soruk eldőlt; a **Megoldás** befejezi a labirintust, ha inkább néznéd."
      }
    },
    "unequal": {
      "step1": {
        "text": "Minden sorba és oszlopba egyszer kell az 1-es, 2-es, 3-as és 4-es — és a két mező közötti minden jelnek a **kisebbik** felé kell mutatnia."
      },
      "step2": {
        "text": "Az itteni jel jobbra mutat, tehát a **bal** mező a nagyobb. Ebbe a sorba még egy 2-es és egy 3-as kell: kattints a bal mezőre, és nyomd meg a **3**-ast.",
        "textTouch": "Az itteni jel jobbra mutat, tehát a **bal** mező a nagyobb. Ebbe a sorba még egy 2-es és egy 3-as kell: koppints a bal mezőre, majd a billentyűk közül a **3**-asra."
      },
      "step3": {
        "text": "Az a mező kapja a kisebb számot, amelyikre a jel mutat. Kattints rá, és nyomd meg a **2**-est.",
        "textTouch": "Az a mező kapja a kisebb számot, amelyikre a jel mutat. Koppints rá, majd a billentyűsoron a **2**-esre."
      },
      "step4": {
        "text": "Az oszlopában már van 3-as, tehát ez a mező csak 2-es lehet. **Kattints rá jobb gombbal**, és nyomd meg a **2**-est, hogy jegyzetként beceruzázd.",
        "textTouch": "Az oszlopában már van 3-as, tehát ez a mező csak 2-es lehet. Koppints rá, rögzítsd a billentyűsoron a **✎** gombot, és koppints a **2**-esre, hogy jegyzetként beceruzázd."
      },
      "step5": {
        "text": "A jegyzet nem válasz. **Kattints** ugyanarra a mezőre, és nyomd meg a **2**-est, hogy véglegesítsd.",
        "textTouch": "A jegyzet nem válasz. A mező még ki van választva, úgyhogy koppints a **✎** gombra, hogy kikapcsold a ceruzát, majd a **2**-esre, hogy véglegesítsd."
      },
      "step6": {
        "text": "Egy mező maradt. Kattints rá, és nyomd meg a **3**-ast, hogy kész legyen a négyzet.",
        "textTouch": "Egy mező maradt. Koppints rá, majd a billentyűsoron a **3**-asra, hogy kész legyen a négyzet."
      },
      "step7": {
        "text": "Megoldva! A **Vissza** visszavon egy számjegyet, a **Megoldás** pedig kitölti a választ, ha egy rejtvény kifog rajtad.",
        "textTouch": "Megoldva! A **Vissza** visszavon egy számjegyet, a **Jelek** és a **Tipp** beceruzázza a lehetőségeket, a **Megoldás** pedig kitölti a választ, ha egy rejtvény kifog rajtad."
      }
    },
    "unruly": {
      "step1": {
        "text": "Színezz minden mezőt feketére vagy fehérre. Minden sorba és oszlopba **háromnak-háromnak** kell kerülnie, és egyik szín sem szerepelhet **háromszor egymás után**. Három mező még eldöntetlen."
      },
      "step2": {
        "text": "Ebben a sorban már megvan a három fehér mező, tehát az eldöntetlennek feketének kell lennie. **Kattints** rá: a kattintás feketére fest."
      },
      "step3": {
        "text": "Ebben a sorban már három fekete van, tehát az eldöntetlen mezője fehér. **Kattints rá jobb gombbal** — a jobb gombos kattintás fordított sorrendben halad, és először fehérre fest."
      },
      "step4": {
        "text": "Az utolsó eldöntetlen mezőtől balra két fekete áll, harmadik egymás után pedig nem jöhet. **Kattints rá jobb gombbal**, fesd fehérre, és kész a rács."
      },
      "step5": {
        "text": "Megoldva! Ha újra egy színes mezőre kattintasz, továbblép a másik színre, majd vissza az eldöntetlenre, a **Vissza** pedig visszalépked a lépéseiden."
      }
    },
    "untangle": {
      "step1": {
        "text": "Hat pont ül egy körön, nyolc vonal köti össze őket. Két párjuk keresztezi egymást — ezek a pirosak. Húzogasd a pontokat, amíg egy piros sem marad."
      },
      "step2": {
        "text": "Először kattints az **Illesztés** gombra, a rácsos gombra a Vissza mellett (vagy nyomd meg a **G**-t). Ez bekapcsolja az illesztőrácsot, így az elengedett pont a mezők közepén lévő halvány pontok egyikére ugrik."
      },
      "step3": {
        "text": "**Húzd** a kör tetején lévő pontot a **bal felső sarokban** lévő üres mezőbe.",
        "textTouch": "**Húzd** a kör tetején lévő pontot a tábla **bal felső sarkában** lévő üres helyre. Nem kell pontosan eltalálnia semmit — csak a keresztezésnek kell megszűnnie."
      },
      "step4": {
        "text": "Egy keresztezés maradt, jobb oldalt. **Húzd** a legalsó pontot az üres **jobb alsó sarokba**.",
        "textTouch": "Egy keresztezés maradt, jobb oldalt. **Húzd** a legalsó pontot az üres **jobb alsó sarokba** — az utolsó piros vonal eltűnik, amint megszűnik a keresztezés."
      },
      "step5": {
        "text": "Kibogozva. A **Megoldás** bármilyen gubancot kibont helyetted, a nyílbillentyűk pedig pontról pontra mozgatják a kurzort, az Enterrel pedig felveszed és leteszed a pontot.",
        "textTouch": "Kibogozva. A piros vonalak azok, amelyek még keresztezik egymást, úgyhogy húzogass, amíg egy sem marad — vagy hagyd, hogy a **Megoldás** bontsa ki a gubancot."
      }
    }
