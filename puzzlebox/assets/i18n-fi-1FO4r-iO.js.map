  "tutorials": {
    "blackbox": {
      "step1": {
        "text": "Tähän 4×4-laatikkoon on piilotettu yksi pallo. Ammu lasereita reunan pisteistä, päättele, missä pallon on oltava, merkitse se ja paina kulman painiketta."
      },
      "step2": {
        "text": "Napsauta pistettä **vasemmassa reunassa, toisen rivin kohdalla**. Säde taipuu matkalla ja tulee ulos muualta; molempiin päihin tulee sama numero."
      },
      "step3": {
        "text": "Ammu nyt **toisen sarakkeen yläpään** pisteestä. **H** tarkoittaa, että säde osui suoraan palloon eikä tullut enää ulos."
      },
      "step4": {
        "text": "Ammu myös **ensimmäisen sarakkeen yläpään** pisteestä. **R** tarkoittaa, että säde kimposi suoraan takaisin ulos — niin käy, kun pallo on vinottain aukon vieressä."
      },
      "step5": {
        "text": "R sijoittaa pallon vinottain ensimmäisen sarakkeen viereen ja H jonnekin toiseen sarakkeeseen: vain tämä ruutu täyttää molemmat ehdot."
      },
      "step6": {
        "text": "**Napsauta sitä ruutua**, niin merkitset pallon siihen."
      },
      "step7": {
        "text": "Kaikki pallot on merkitty, joten **vasemman yläkulman väkänen** on nyt käytettävissä. Napsauta sitä, niin vastauksesi tarkistetaan."
      },
      "step8": {
        "text": "Oikein! Kun olet varma, että ruutu on tyhjä, voit lukita sen: **napsauta hiiren oikealla** sitä. **Ratkaise** taas paljastaa vastauksen."
      }
    },
    "bridges": {
      "step1": {
        "text": "Saaren numero kertoo, montako sillanpäätä se haluaa. Liitä kaikki saaret yhdeksi verkoksi niin, että saariparin välillä on enintään kaksi siltaa eikä yksikään silta risteä toisen kanssa."
      },
      "step2": {
        "text": "**Alimmalla 2:lla** on samassa linjassa vain yksi saari: ylhäällä oleva **4**. **Vedä** 2:sta kohti 4:ää, niin rakennat sillan niiden välille."
      },
      "step3": {
        "text": "Se haluaa kaksi sillanpäätä, ja tämä pari on ainoa paikka niille. **Vedä** samalla tavalla uudestaan, niin saat toisen, rinnakkaisen sillan."
      },
      "step4": {
        "text": "Se saari on valmis. **Napsauta** sitä, niin merkitset sen valmiiksi: se harmaantuu ja sen sillat lukittuvat, etkä sotke niitä vahingossa."
      },
      "step5": {
        "text": "Sillat eivät saa risteillä, joten **kahden 1:n** välille ei voi enää tulla siltaa. **Vedä hiiren oikealla** vasemmasta 1:stä kohti oikeaa, niin merkitset sen."
      },
      "step6": {
        "text": "Kummallakin 1:llä on nyt vain yksi suunta, ja siitä selviävät loput neljä siltaa. **Ratkaise** vie pulman loppuun (ja **G** näyttää kaikki linjat, joille silta voisi tulla).",
        "textTouch": "Kummallakin 1:llä on nyt vain yksi suunta, ja siitä selviävät loput neljä siltaa. **Ratkaise** vie pulman loppuun."
      }
    },
    "cube": {
      "step1": {
        "text": "Kuutiolla on kuusi tahkoa ja kuusi ruutua on maalattu sinisiksi. Vieritä sitä, kunnes jokainen tahko on kerännyt yhden: joka kerta kun kuutio laskeutuu, alla oleva tahko ja ruutu vaihtavat värit keskenään."
      },
      "step2": {
        "text": "Napsautus kallistaa kuution reunansa yli kohti valitsemaasi ruutua. **Napsauta kuution alapuolella olevaa sinistä ruutua**, niin sen väri siirtyy alas laskeutuvaan tahkoon."
      },
      "step3": {
        "text": "Ruutu, jolta kuutio lähti, on nyt tyhjä — värit todella vaihtuvat. **Napsauta oikeanpuoleista sinistä ruutua**, niin toinenkin tahko muuttuu siniseksi."
      },
      "step4": {
        "text": "Myös **nuolinäppäimet** vierittävät kuutiota. Paina **→** kerran, niin poimit kolmannen sinisen ruudun.",
        "textTouch": "Jokainen naapuriruutu on yhden napautuksen päässä. **Napauta seuraavaa sinistä ruutua oikealla**, niin poimit kolmannen sinisen ruudun."
      },
      "step5": {
        "text": "Kolme tahkoa sinisenä, kolme jäljellä — tämä lauta ratkeaa kaikkiaan kuudella vierityksellä, ja tilarivi laskee ne. **Kumoa** ottaa yhden takaisin, jos menet yli."
      }
    },
    "dominosa": {
      "step1": {
        "text": "Tähän aseteltiin kolme dominoa — 0-0, 0-1 ja 1-1 — ja ne otettiin pois, mutta numerot jäivät. Jaa ruudukko pareiksi ja pane jokainen domino takaisin täsmälleen kerran."
      },
      "step2": {
        "text": "Samaa dominoa ei saa käyttää kahdesti. Jos tämä **0** olisi pari allaan olevan **1**:n kanssa, molemmista reunasarakkeista tulisi 0-1, joten **napsauta hiiren oikealla** niiden välistä rajaa ja merkitse, etteivät ne ole pari."
      },
      "step3": {
        "text": "Ainoat kaksi toisiaan koskettavaa **0**:aa ovat vasemmassa yläkulmassa, joten sinne 0-0 kuuluu. **Napsauta niiden välistä rajaa**, niin asetat sen."
      },
      "step4": {
        "text": "Samoin ainoat toisiaan koskettavat **1**:t ovat vasemmalla alhaalla. Napsauta niiden välistä rajaa, niin saat 1-1:n."
      },
      "step5": {
        "text": "Jäljelle jää oikeanpuoleinen sarake 0-1:lle. Napsauta sen kahden numeron välistä rajaa, niin pulma on valmis."
      },
      "step6": {
        "text": "Jokainen domino käytetty kerran. Napsauta dominoa uudestaan, niin nostat sen pois; kahdesti esiintyvä piirtyy punaisena, ja **Kumoa** peruu siirtojasi."
      }
    },
    "fifteen": {
      "step1": {
        "text": "Liu'uta numerolaattoja tyhjään tilaan, kunnes ne ovat järjestyksessä **1–8** ja aukko on oikeassa alakulmassa. Tämä pikkulauta on kahden siirron päässä valmiista."
      },
      "step2": {
        "text": "Mikä tahansa laatta samalla rivillä tai samassa sarakkeessa aukon kanssa voi liukua. Napsauta **5**:ttä, niin työnnät sen ylös aukkoon."
      },
      "step3": {
        "text": "Vielä yksi. Napsauta **8**:aa, niin rivi on valmis."
      },
      "step4": {
        "text": "Ratkaistu! **Kumoa** ja **Tee uudelleen** liikkuvat siirroissasi taakse- ja eteenpäin, ja taukovalikon **Uusi** tuo uuden pulman. Myös nuolinäppäimillä voi liu'uttaa laatan aukkoon nuolen suuntaan.",
        "textTouch": "Ratkaistu! **Kumoa** ja **Tee uudelleen** liikkuvat siirroissasi taakse- ja eteenpäin, ja taukovalikon **Uusi** tuo uuden pulman. Koko rivi tai sarake liukuu kerralla, joten tähtää kauimmaiseen laattaan."
      }
    },
    "filling": {
      "step1": {
        "text": "Kirjoita jokaiseen tyhjään ruutuun numero niin, että jokainen yhtenäinen samojen numeroiden lohko kattaa täsmälleen niin monta ruutua kuin numero sanoo."
      },
      "step2": {
        "text": "Keskisarakkeen alalaidan **3** voi kasvaa vain ylöspäin, joten sen lohko on koko sarake. **Vedä** sarakkeen ylimmästä ruudusta keskimmäiseen ja paina sitten **3**.",
        "textTouch": "Keskisarakkeen alalaidan **3** voi kasvaa vain ylöspäin. **Vedä** sarakkeen ylimmästä ruudusta keskimmäiseen ja napauta sitten näppäimistä **3**."
      },
      "step3": {
        "text": "Vasemman sarakkeen **2** tarvitsee yhden kumppanin, ja sen yläpuolinen ruutu on ainoa vapaa. Napsauta sitä ruutua ja paina **2**.",
        "textTouch": "Vasemman sarakkeen **2** tarvitsee yhden kumppanin, ja sen yläpuolinen ruutu on ainoa vapaa. Napauta sitä ruutua ja napauta sitten laudan alta **2**."
      },
      "step4": {
        "text": "Yksi ruutu jäljellä. Napsauta sitä ja paina **1**, niin näet miltä väärä numero näyttää.",
        "textTouch": "Yksi ruutu jäljellä. Napauta sitä ja napauta laudan alta **1**, niin näet miltä väärä numero näyttää."
      },
      "step5": {
        "text": "Punainen tarkoittaa mahdotonta: nuo kaksi **1**:tä koskettavat toisiaan, jolloin syntyisi kahden lohko, ja ylhäällä oleva **2** jää muurin taakse. Ruutu on yhä valittuna, joten tyhjennä se painamalla **Backspace**.",
        "textTouch": "Punainen tarkoittaa mahdotonta: nuo kaksi **1**:tä koskettavat toisiaan, jolloin syntyisi kahden lohko, ja ylhäällä oleva **2** jää muurin taakse. Ruutu on yhä valittuna, joten tyhjennä se laudan alta **⌫**:llä."
      },
      "step6": {
        "text": "Tyhjä ruutu pariutuukin yläpuolisen **2**:n kanssa. Napsauta sitä ja paina **2**, niin ruudukko on valmis.",
        "textTouch": "Tyhjä ruutu pariutuukin yläpuolisen **2**:n kanssa. Napauta sitä ja napauta laudan alta **2**, niin ruudukko on valmis."
      },
      "step7": {
        "text": "Täynnä! Paksut viivat rajaavat jokaisen valmiin lohkon; **napsautus hiiren oikealla** lisää ruutuja valintaan yksi kerrallaan, ja **Kumoa** peruu täytön."
      }
    },
    "flip": {
      "step1": {
        "text": "Sytytä kaikki yhdeksän ruutua. Ruudun painaminen kääntää sen **ja** sen ympärillä olevat ruudut, joten palavat ruudut voivat sammua taas."
      },
      "step2": {
        "text": "Ruudun sisällä oleva pikkukuva näyttää, mitä se kääntää: umpinainen laatikko on ruutu itse, ääriviivat ovat sen naapurit."
      },
      "step3": {
        "text": "Nyt sytytetään. Paina **vasemman yläkulman** ruutua, sitä pimeää."
      },
      "step4": {
        "text": "Kulma palaa, mutta sen kaksi naapuria pimenivät. Paina seuraavaksi **keskimmäistä** ruutua."
      },
      "step5": {
        "text": "Enää oikea alakulma on pimeänä. Paina **oikean alakulman** ruutua, niin kaikki palaa."
      },
      "step6": {
        "text": "Kaikki palaa! **Kumoa** peruu painalluksen, ja voit ohjata kohdistinta nuolinäppäimillä ja painaa Enteriä napsautuksen sijaan.",
        "textTouch": "Kaikki palaa! **Kumoa** peruu painalluksen, ja saman ruudun painaminen kahdesti kumoutuu aina itsestään, joten järjestyksellä ei ole väliä."
      }
    },
    "flood": {
      "step1": {
        "text": "Hallitset vasemman yläkulman ruutua ja kaikkea siihen liittyvää samanväristä aluetta. Jokainen siirto maalaa tämän laikun uudelleen, ja siihen koskettavat uudenväriset ruudut liittyvät mukaan. Tee koko ruudukosta yksivärinen enintään **neljällä siirrolla**."
      },
      "step2": {
        "text": "Laikkusi on toistaiseksi vain tuo yksi sininen kulma. Napsauta sen vieressä olevaa **punaista** ruutua: laikku muuttuu punaiseksi ja jokainen sen koskettama punainen ruutu tulee mukaan."
      },
      "step3": {
        "text": "Napsauta nyt **sinistä** ruutua laikkusi reunalla. Hyvin valittu väri voi levitä ketjuna pitkälle ruudukon poikki yhdellä siirrolla."
      },
      "step4": {
        "text": "Laikun ulkopuolelle jää enää **vihreää**. Yksi napsautus lisää pyyhkäisee lopun ruudukosta mukaan."
      },
      "step5": {
        "text": "Kolme siirtoa neljästä — tilarivi pitää lukua. Jos siirrot loppuvat ennen kuin ruudukko on yksivärinen, hävisit kierroksen. Jumissa? **Vihje** pelaa puolestasi yhden hyvän värin, ja **Ratkaise** viimeistelee ruudukon automaattisesti."
      }
    },
    "galaxies": {
      "step1": {
        "text": "Kaksi pistettä, siis kaksi galaksia. Piirrä seiniä ruudukon viivoja pitkin niin, että jokainen piste päätyy oman alueensa keskipisteeksi: käännä aluetta 180° sen pisteen ympäri, ja sen on osuttava täsmälleen itsensä päälle."
      },
      "step2": {
        "text": "Vasen piste on kahden ruudun välisellä viivalla, joten sen galaksin on oltava kaksi vasemmanpuoleista saraketta. **Napsauta** ruudukon viivaa heti niiden oikealla puolella, **ylimmällä rivillä**."
      },
      "step3": {
        "text": "Pisteet toimivat myös muistilappuna. **Vedä** oikeanpuoleisesta pisteestä **oikeaan yläkulman ruutuun**, niin jätät sinne nuolen, joka merkitsee ruudun osaksi sen galaksia."
      },
      "step4": {
        "text": "Takaisin seinään: **napsauta** samaa ruudukon viivaa yhtä riviä alempana, **keskirivillä**."
      },
      "step5": {
        "text": "Yksi pätkä jäljellä, **alimmalla rivillä**. **Napsauta** sitä, niin molemmat galaksit sulkeutuvat."
      },
      "step6": {
        "text": "Molemmat alueet on sävytetty, eli ne ovat oikein. **Ratkaise** piirtää koko vastauksen, ja seinän napsauttaminen pyyhkii sen taas pois."
      }
    },
    "guess": {
      "step1": {
        "text": "Kysymysmerkkien takana on kaksi nappulaa kolmesta väristä jossain järjestyksessä. Arvaa rivi, katso, mitä merkkejä se saa, ja rajaa vaihtoehtoja."
      },
      "step2": {
        "text": "**Vedä** ylin väri lokerikosta ja pudota se nuolella merkityn rivin **vasempaan reikään**."
      },
      "step3": {
        "text": "Voit myös poimia värin ensin ja napsauttaa sillä reikiä. Napsauta lokerikon **toista väriä**."
      },
      "step4": {
        "text": "Napsauta nyt **oikeanpuoleista reikää**, niin väri putoaa siihen."
      },
      "step5": {
        "text": "Rivi on täynnä, joten sen oikealla puolella oleva **katkoviivalaatikko** syttyy. Napsauta sitä, niin arvauksesi arvioidaan."
      },
      "step6": {
        "text": "Kaksi **onttoa** merkkiä tarkoittaa, että molemmat värit ovat vastauksessa, mutta kumpikaan ei ole oikealla paikalla — umpinainen merkki tarkoittaisi oikeaa väriä oikealla paikalla. Vaihda ne keskenään ja tarkista uudestaan."
      },
      "step7": {
        "text": "Ratkaistu. **Ratkaise** luovuttaa ja näyttää vastauksen, ja **L**-näppäin merkitsee nappulat kirjaimin, jos värejä on vaikea erottaa.",
        "textTouch": "Ratkaistu. **Ratkaise** luovuttaa ja näyttää vastauksen, ja Kumoa-painikkeen vieressä oleva **Lukitse** pitää varman nappulan paikallaan seuraavaa arvausta varten."
      }
    },
    "inertia": {
      "step1": {
        "text": "Sinä olet vasemman yläkulman pallo, ja kerättävänä on **kolme jalokiveä**. Kun pallo lähtee vierimään, se pysähtyy vasta seinään tai pysäyttimeen — ja miina tappaa sen."
      },
      "step2": {
        "text": "Napsauta jotain ruutua pallon **oikealla puolella**. Pallo vierii sinne päin, kunnes laudan reuna pysäyttää sen, ja korjaa matkalta jalokiven."
      },
      "step3": {
        "text": "Napsauta nyt pallon **alapuolelle**. Se poimii seuraavan jalokiven, ja kahden ruudun päässä oleva rikkonainen rengas — pysäytin — pysäyttää sen."
      },
      "step4": {
        "text": "Varo: piikikäs otus suoraan pallon alapuolella on **miina**. Sen päälle vieriminen päättää pelin, ja vain Kumoa pelastaa siitä."
      },
      "step5": {
        "text": "Mene sen sijaan **vinottain**: napsauta ruutua kaksi alas ja kaksi vasemmalle, niin pallo liukuu miinan ohi viimeiselle jalokivelle."
      },
      "step6": {
        "text": "Kaikki kolme jalokiveä — valmista. **Kumoa** kelaa väärin menneen vierityksen takaisin; nuolinäppäimet vierittävät suoraan ja Home, Page Up, End ja Page Down vinottain.",
        "textTouch": "Kaikki kolme jalokiveä — valmista. **Kumoa** kelaa väärin menneen vierityksen takaisin, ja ruudukon ulkopuolelle napauttaminen toimii sekin, mikä auttaa kun pallo on reunaa vasten."
      }
    },
    "keen": {
      "step1": {
        "text": "Täytä 1, 2 ja 3 niin, että kukin esiintyy kerran joka rivillä ja sarakkeessa ja että paksusti rajatun alueen numerot toteuttavat sen laskuvihjeen."
      },
      "step2": {
        "text": "**2×**-alueen tulo on 2, joten sen numerot ovat 1, 1 ja 2. Alueessa numero saa toistua, mutta ei rivillä tai sarakkeessa, joten 2 kuuluu kulmaan: napsauta sitä ruutua ja kirjoita **2**.",
        "textTouch": "**2×**-alueen tulo on 2, joten sen numerot ovat 1, 1 ja 2. Kakkonen kuuluu kulmaan: napauta sitä ruutua ja napauta näppäimistä **2**."
