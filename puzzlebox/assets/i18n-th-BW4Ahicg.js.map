  "tutorials": {
    "blackbox": {
      "step1": {
        "text": "มีลูกบอลหนึ่งลูกซ่อนอยู่ในกล่อง 4×4 นี้ ยิงเลเซอร์เข้าไปจากจุดรอบขอบ หาว่าลูกบอลต้องอยู่ตรงไหน ทำเครื่องหมาย แล้วกดปุ่มที่มุม"
      },
      "step2": {
        "text": "คลิกจุดที่ **ขอบซ้าย ตรงกับแถวที่สอง** ลำแสงจะถูกหักเหระหว่างทางแล้วออกไปที่อื่น ปลายทั้งสองข้างจะได้ตัวเลขเดียวกัน"
      },
      "step3": {
        "text": "ต่อไปยิงจุดที่ **ด้านบนของคอลัมน์ที่สอง** ตัว **H** หมายความว่าลำแสงพุ่งชนลูกบอลตรง ๆ และไม่ได้ออกมาอีกเลย"
      },
      "step4": {
        "text": "ยิงจุดที่ **ด้านบนของคอลัมน์แรก** ด้วย ตัว **R** หมายความว่าลำแสงสะท้อนย้อนกลับออกมาทางเดิม ซึ่งเกิดขึ้นเมื่อมีลูกบอลอยู่ในแนวทแยงข้างช่องยิง"
      },
      "step5": {
        "text": "ตัว R บอกว่ามีลูกบอลอยู่ในแนวทแยงข้างคอลัมน์แรก และตัว H บอกว่ามีลูกบอลอยู่ตรงลงไปในคอลัมน์ที่สอง มีเพียงช่องนี้ช่องเดียวที่ตรงกับทั้งสองอย่าง"
      },
      "step6": {
        "text": "**คลิกช่องนั้น** เพื่อทำเครื่องหมายลูกบอลไว้ตรงนั้น"
      },
      "step7": {
        "text": "ทำเครื่องหมายลูกบอลครบแล้ว **เครื่องหมายถูกที่มุมซ้ายบน** จึงกดได้ คลิกเพื่อให้ตรวจคำตอบ"
      },
      "step8": {
        "text": "ถูกต้อง ระหว่างเล่น **คลิกขวา** ช่องที่แน่ใจว่าว่างเพื่อล็อกไว้ และปุ่ม **เฉลย** จะบอกคำตอบให้"
      }
    },
    "bridges": {
      "step1": {
        "text": "ตัวเลขบนเกาะแต่ละเกาะคือจำนวนปลายสะพานที่เกาะนั้นต้องการ เชื่อมทุกเกาะให้เป็นเครือข่ายเดียว โดยระหว่างเกาะคู่หนึ่งมีสะพานได้ไม่เกินสองสะพาน และไม่มีสะพานไหนตัดกัน"
      },
      "step2": {
        "text": "เลข **2 ด้านล่าง** มีเกาะอยู่ในแนวเดียวกันแค่เกาะเดียว คือเลข **4** ด้านบน **ลาก** จากเลข 2 ไปทางเลข 4 เพื่อสร้างสะพาน"
      },
      "step3": {
        "text": "เกาะนี้ต้องการปลายสะพานสองปลาย และคู่นี้เป็นที่เดียวที่วางได้ **ลาก** ไปทางเดิมอีกครั้งเพื่อสร้างสะพานที่สองคู่ขนานกัน"
      },
      "step4": {
        "text": "เกาะนี้ครบแล้ว **คลิก** ที่เกาะเพื่อทำเครื่องหมายว่าเสร็จ เกาะจะกลายเป็นสีเทาและสะพานจะถูกล็อก จึงไม่เผลอไปแก้โดยไม่ตั้งใจ"
      },
      "step5": {
        "text": "สะพานห้ามตัดกัน ดังนั้นแนวระหว่าง **เลข 1 ทั้งสอง** จึงใช้ไม่ได้แล้ว **คลิกขวาแล้วลาก** จากเลข 1 ทางซ้ายไปทางเลข 1 ทางขวาเพื่อจดไว้"
      },
      "step6": {
        "text": "ตอนนี้เลข 1 แต่ละตัวมีทางออกเหลือทางเดียว และสะพานอีกสี่สะพานที่เหลือก็ตามมาจากตรงนั้น **เฉลย** จะไขปริศนาที่เหลือให้ (และ **G** จะแสดงทุกแนวที่สะพานวางได้)",
        "textTouch": "ตอนนี้เลข 1 แต่ละตัวมีทางออกเหลือทางเดียว และสะพานอีกสี่สะพานที่เหลือก็ตามมาจากตรงนั้น **เฉลย** จะไขปริศนาที่เหลือให้"
      }
    },
    "cube": {
      "step1": {
        "text": "ลูกบาศก์มีหกหน้า และมีหกช่องที่ทาสีน้ำเงินไว้ กลิ้งลูกบาศก์ไปรอบ ๆ จนทุกหน้าเก็บสีได้หน้าละช่อง ทุกครั้งที่ลูกบาศก์ตกลงบนช่อง หน้าที่อยู่ด้านล่างกับช่องนั้นจะสลับสีกัน"
      },
      "step2": {
        "text": "การคลิกจะทำให้ลูกบาศก์พลิกข้ามขอบไปทางช่องที่เลือก **คลิกช่องสีน้ำเงินที่อยู่ใต้ลูกบาศก์** เพื่อเก็บสีนั้นขึ้นมาไว้บนหน้าที่ตกลงไป"
      },
      "step3": {
        "text": "ช่องที่ลูกบาศก์เพิ่งออกมากลายเป็นช่องธรรมดาแล้ว — สีสลับกันจริง ๆ **คลิกช่องสีน้ำเงินทางขวา** เพื่อให้หน้าที่สองเป็นสีน้ำเงิน"
      },
      "step4": {
        "text": "**ปุ่มลูกศร** ก็กลิ้งลูกบาศก์ได้เหมือนกัน กด **→** หนึ่งครั้งเพื่อเก็บช่องสีน้ำเงินช่องที่สาม",
        "textTouch": "ทุกช่องที่อยู่ติดกันไปถึงได้ด้วยการแตะครั้งเดียว **แตะช่องสีน้ำเงินถัดไปทางขวา** เพื่อเก็บช่องสีน้ำเงินช่องที่สาม"
      },
      "step5": {
        "text": "สีน้ำเงินแล้วสามหน้า เหลืออีกสามหน้า — กระดานนี้ไขได้ในการกลิ้งทั้งหมดหกครั้ง และแถบสถานะจะนับให้ ถ้ากลิ้งเลยไป **เลิกทำ** จะย้อนกลับได้ทีละครั้ง"
      }
    },
    "dominosa": {
      "step1": {
        "text": "โดมิโนสามชิ้น — 0-0, 0-1 และ 1-1 — เคยถูกวางไว้ตรงนี้แล้วถูกยกออก เหลือไว้แต่ตัวเลข แบ่งตารางเป็นคู่ ๆ เพื่อวางโดมิโนแต่ละชิ้นกลับคืนเพียงครั้งเดียว"
      },
      "step2": {
        "text": "ห้ามใช้โดมิโนชิ้นเดียวกันซ้ำ ถ้าจับคู่ **0** ตัวนี้กับ **1** ด้านล่าง คอลัมน์ด้านนอกทั้งสองจะเป็น 0-1 ทั้งคู่ ดังนั้น **คลิกขวา** ระหว่างสองช่องนี้เพื่อจดว่าไม่ใช่คู่กัน"
      },
      "step3": {
        "text": "**0** ที่อยู่ติดกันมีแค่คู่ที่มุมซ้ายบน โดมิโน 0-0 จึงอยู่ตรงนั้น **คลิกเส้นแบ่งระหว่างสองช่องนั้น** เพื่อวางโดมิโน"
      },
      "step4": {
        "text": "ในทำนองเดียวกัน **1** ที่อยู่ติดกันมีแค่สองช่องทางด้านล่างซ้าย คลิกเส้นแบ่งระหว่างสองช่องนั้นเพื่อวาง 1-1"
      },
      "step5": {
        "text": "เหลือคอลัมน์ทางขวาไว้สำหรับ 0-1 คลิกเส้นแบ่งระหว่างตัวเลขสองตัวในคอลัมน์นั้นเพื่อจบเกม"
      },
      "step6": {
        "text": "ใช้โดมิโนครบทุกชิ้นชิ้นละครั้ง คลิกโดมิโนอีกครั้งเพื่อยกออก โดมิโนที่ซ้ำจะแสดงเป็นสีแดง และ **เลิกทำ** จะย้อนการเดินทีละตา"
      }
    },
    "fifteen": {
      "step1": {
        "text": "เลื่อนแผ่นตัวเลขเข้าไปในช่องว่างจนเรียง **1 ถึง 8** ตามลำดับ โดยให้ช่องว่างอยู่ที่มุมขวาล่าง กระดานเล็ก ๆ นี้เหลืออีกสองตาก็เสร็จ"
      },
      "step2": {
        "text": "แผ่นใดก็ตามที่อยู่ในแถวหรือคอลัมน์เดียวกับช่องว่างเลื่อนได้ คลิกเลข **5** เพื่อดันขึ้นไปในช่องว่าง"
      },
      "step3": {
        "text": "อีกตาเดียว คลิกเลข **8** เพื่อเรียงแถวให้ครบ"
      },
      "step4": {
        "text": "ไขสำเร็จ! **เลิกทำ** และ **ทำซ้ำ** ย้อนหรือเดินหน้าการเดินทีละตา และ **ใหม่** ในเมนูหยุดชั่วคราวจะเริ่มปริศนาใหม่ ปุ่มลูกศรก็เลื่อนแผ่นเข้าไปในช่องว่างได้ตามทิศของลูกศร",
        "textTouch": "ไขสำเร็จ! **เลิกทำ** และ **ทำซ้ำ** ย้อนหรือเดินหน้าการเดินทีละตา และ **ใหม่** ในเมนูหยุดชั่วคราวจะเริ่มปริศนาใหม่ ทั้งแถวหรือทั้งคอลัมน์เลื่อนได้พร้อมกัน จึงแตะแผ่นที่อยู่ไกลสุดได้เลย"
      }
    },
    "filling": {
      "step1": {
        "text": "เขียนตัวเลขลงในทุกช่องว่าง ให้แต่ละกลุ่มของตัวเลขเดียวกันที่ติดกันครอบคลุมจำนวนช่องเท่ากับตัวเลขนั้นพอดี"
