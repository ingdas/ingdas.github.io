  "tutorials": {
    "blackbox": {
      "step1": {
        "text": "În această cutie de 4×4 se ascunde o bilă. Trage cu laserul din punctele de pe margine, deduce unde trebuie să fie, marcheaz-o și apasă butonul din colț."
      },
      "step2": {
        "text": "**Dă clic pe punctul de pe marginea stângă, în dreptul rândului al doilea**. Raza e deviată pe drum și iese în altă parte; ambele capete primesc același număr."
      },
      "step3": {
        "text": "Acum trage din punctul **de deasupra coloanei a doua**. Un **H** înseamnă că raza a lovit direct o bilă și nu a mai ieșit."
      },
      "step4": {
        "text": "Trage și din punctul **de deasupra primei coloane**. Un **R** înseamnă că raza s-a întors direct înapoi, ceea ce se întâmplă când o bilă stă în diagonală lângă orificiu."
      },
      "step5": {
        "text": "R-ul pune o bilă în diagonală lângă prima coloană, iar H-ul pune una drept în jos pe a doua: doar această căsuță le satisface pe amândouă."
      },
      "step6": {
        "text": "**Dă clic pe acea căsuță** ca să-ți marchezi bila acolo."
      },
      "step7": {
        "text": "Toate bilele sunt marcate, așa că **bifa din colțul din stânga sus** e activă. Dă clic pe ea ca să-ți fie verificat răspunsul."
      },
      "step8": {
        "text": "Corect. În timp ce lucrezi, **dă clic dreapta** pe o căsuță ca s-o blochezi cu lacăt când ești sigur că e goală, iar **Rezolvă** îți arată răspunsul."
      }
    },
    "bridges": {
      "step1": {
        "text": "Numărul fiecărei insule arată câte capete de pod vrea. Unește toate insulele într-o singură rețea, cu cel mult două poduri între o pereche și fără ca un pod să treacă peste altul."
      },
      "step2": {
        "text": "**2-ul de jos** are o singură insulă în linie cu el: **4-ul** de sus. **Trage** de la 2 spre 4 ca să arunci un pod peste."
      },
      "step3": {
        "text": "Vrea două capete de pod, iar perechea asta e singurul loc unde pot merge. **Trage** din nou în aceeași direcție pentru un al doilea pod, paralel."
      },
      "step4": {
        "text": "Insula aceea e gata. **Dă clic** pe ea ca s-o marchezi terminată: devine gri și podurile ei se blochează, ca să nu le strici din greșeală."
      },
      "step5": {
        "text": "Niciun pod nu poate trece peste altul, așa că legătura dintre **cei doi de 1** e acum imposibilă. **Trage cu butonul drept** de la 1-ul din stânga spre cel din dreapta ca să notezi asta."
      },
      "step6": {
        "text": "Fiecare 1 mai are acum o singură ieșire, iar cele patru poduri rămase decurg de aici. **Rezolvă** termină puzzle-ul (iar **G** arată fiecare linie pe care ar putea trece un pod).",
        "textTouch": "Fiecare 1 mai are acum o singură ieșire, iar cele patru poduri rămase decurg de aici. **Rezolvă** termină puzzle-ul."
      }
    },
    "cube": {
      "step1": {
        "text": "Cubul are șase fețe, iar șase căsuțe sunt vopsite în albastru. Rostogolește-l până când fiecare față a adunat una: de fiecare dată când aterizează, fața de dedesubt și căsuța își schimbă culorile."
      },
      "step2": {
        "text": "Un clic răstoarnă cubul peste muchie spre căsuța aleasă. **Dă clic pe căsuța albastră chiar sub cub** ca să-i iei culoarea pe fața care aterizează."
      },
      "step3": {
        "text": "Căsuța părăsită e acum simplă — culorile chiar se schimbă între ele. **Dă clic pe căsuța albastră din dreapta** ca să faci albastră a doua față."
      },
      "step4": {
        "text": "Și **tastele săgeți** rostogolesc cubul. Apasă o dată **→** ca să iei a treia căsuță albastră.",
        "textTouch": "Fiecare căsuță vecină e la o apăsare distanță. **Apasă pe următoarea căsuță albastră din dreapta** ca să iei a treia căsuță albastră."
      },
      "step5": {
        "text": "Trei fețe albastre, mai sunt trei — tabla asta se poate termina în șase rostogoliri în total, iar bara de stare le numără. **Anulează** îți dă una înapoi când mergi prea departe."
      }
    },
    "dominosa": {
      "step1": {
        "text": "Trei piese de domino — 0-0, 0-1 și 1-1 — au fost așezate aici și apoi luate, lăsând în urmă numerele. Împarte grila în perechi ca să pui fiecare piesă la loc exact o dată."
      },
      "step2": {
        "text": "Nicio piesă nu poate fi folosită de două ori. Dacă ai împerechea acest **0** cu **1**-ul de sub el, ambele coloane exterioare ar fi 0-1, așa că **dă clic dreapta** între ele ca să notezi că nu formează o pereche."
      },
      "step3": {
        "text": "Singurii doi **0** care se ating sunt perechea din colțul din stânga sus, deci acolo merge 0-0. **Dă clic pe granița dintre ei** ca s-o așezi."
      },
      "step4": {
        "text": "La fel, singurii **1** care se ating sunt cei doi din stânga jos. Dă clic pe granița dintre ei pentru 1-1."
      },
      "step5": {
        "text": "Rămâne coloana din dreapta pentru 0-1. Dă clic pe granița dintre cele două numere ale ei ca să termini."
      },
      "step6": {
        "text": "Fiecare piesă folosită o dată. Încă un clic pe o piesă o ridică, o piesă repetată e desenată cu roșu, iar **Anulează** te duce înapoi prin mutări."
      }
    },
    "fifteen": {
      "step1": {
        "text": "Glisează piesele numerotate în spațiul gol până când se citesc de la **1 la 8** în ordine, cu golul în colțul din dreapta jos. Tabla aceasta mică e la două mutări de final."
      },
      "step2": {
