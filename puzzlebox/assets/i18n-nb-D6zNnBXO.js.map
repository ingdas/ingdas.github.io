    "netslide": {
      "step1": {
        "text": "Hver bit ledning må til slutt henge sammen med strømkilden. Blå ledninger har strøm, de grå har det ikke."
      },
      "step2": {
        "text": "Kilden sitter på midtbrikken. Den brikken flytter seg aldri, så midtraden og midtkolonnen har ingen piler — alt annet skyves rundt."
      },
      "step3": {
        "text": "Klikk på pilen til **venstre for nederste rad** for å skyve raden ett steg mot venstre; ledningen som faller av, dukker opp igjen til høyre."
      },
      "step4": {
        "text": "Nederste rad henger sammen nå, men den er fortsatt grå: ingenting knytter den oppover til kilden ennå."
      },
      "step5": {
        "text": "**Høyreklikk på** pilen **over tredje kolonne**. Et høyreklikk snur pilen, så kolonnen skyves nedover og de siste ledningene lyser opp."
      },
      "step6": {
        "text": "Alt har strøm! **Løs** viser et svar hvis du står fast, og **Type**-menyen har rutenett som går rundt, der ledninger løper ut på én kant og inn på den motsatte."
      }
    },
    "pattern": {
      "step1": {
        "text": "Tallene ved hver rad og kolonne er lengdene på de svarte blokkene i den linjen, i rekkefølge. Finn ut hvilke ruter som er svarte, og fyll dem inn."
      },
      "step2": {
        "text": "**Tredje kolonne** sier 1 2: én svart, et opphold, så to svarte. På fire ruter passer det bare på én måte, med paret nederst. **Dra** nedover over dem."
      },
      "step3": {
        "text": "Da må ruten over paret være oppholdet. **Høyreklikk** på den for å sette en prikk, som markerer en rute du vet er hvit."
      },
      "step4": {
        "text": "Og den øverste ruten i kolonnen er den enslige svarte i ledetråden. **Klikk** på den."
      },
      "step5": {
        "text": "**Siste kolonne** sier 3. Uansett hvor en blokk på tre ligger på fire ruter, dekker den alltid de to i midten, så **dra** nedover over dem."
      },
      "step6": {
        "text": "En ledetråd blir grå når linjen er ferdig. Fortsett å jobbe deg videre bit for bit, eller la **Løs** gjøre resten; midtklikk på en rute for å nullstille den til ukjent."
      }
    },
    "pearl": {
      "step1": {
        "text": "Tegn én lukket løkke fra midten av én rute til midten av den neste. Den trenger ikke å gå innom alle rutene, men den må gå gjennom hver eneste perle."
      },
      "step2": {
        "text": "En **hvit perle** betyr at løkken går rett gjennom den. På øverste rad er sidelengs den eneste rette veien, så **dra** fra ruten til venstre for perlen til ruten til høyre for den."
      },
      "step3": {
        "text": "Nå har perlen begge strekene sine, så ingenting mer kan gå ut fra den. **Høyreklikk** på kanten under den for å krysse ut den siden."
      },
      "step4": {
        "text": "Ved en **svart perle** svinger løkken, og så går den rett gjennom ruten på hver side av perlen. Perlen på **venstre kant** kan ikke svinge nedover – da måtte streken gå rett gjennom hjørnet nederst til venstre – så **klikk** på kanten til høyre for den."
      },
      "step5": {
        "text": "Da går løkken rett videre gjennom ruten ved siden av – og gjennom den hvite perlen bortenfor. **Dra** fra den ruten bort til fjerde kolonne."
      },
      "step6": {
        "text": "Fortsett å resonnere deg utover fra perlene; en perle får en rød ring rundt seg så snart regelen dens brytes. **Løs** tegner hele løkken hvis du vil se den."
      }
    },
    "pegs": {
      "step1": {
        "text": "En pinne hopper over en nabo og ned i det tomme hullet bak, og pinnen den hoppet over blir fjernet. Rydd dette lille brettet ned til **én pinne**: tre hopp."
      },
      "step2": {
        "text": "**Dra** pinnen øverst på stilken ned over naboen sin, ned i hullet nederst."
      },
      "step3": {
        "text": "Det går også an å klikke. Klikk på **pinnen til høyre** for å plukke den opp, og klikk så på hullet to ruter til venstre."
      },
      "step4": {
        "text": "Siste hopp: dra pinnen i **nederste venstre hjørne** over naboen sin og inn i midten."
      },
      "step5": {
        "text": "Én pinne igjen — løst. **Angre** tar et hopp tilbake når du kjører deg fast, og piltastene virker også: Enter plukker opp en pinne, og en piltast skyver den av gårde.",
        "textTouch": "Én pinne igjen — løst. **Angre** tar et hopp tilbake hver gang du kjører deg fast, så langt tilbake du vil."
      }
    },
    "range": {
      "step1": {
        "text": "Farg ruter svarte slik at hvert tall er lik antallet hvite ruter det ser: seg selv, pluss hver rute på rett linje opp, ned, til venstre og til høyre helt til en svart rute eller kanten stopper blikket."
      },
      "step2": {
        "text": "Tallet **6** ser seks ruter akkurat nå — hele raden sin pluss de to under. Da kan ingenting i den raden eller kolonnen bli svart."
      },
      "step3": {
        "text": "Tallet **2** får bare se seg selv og én rute til, og ruten over må være hvit for 6-erens skyld. Så **klikk** på ruten til venstre for å farge den svart."
      },
      "step4": {
        "text": "Da er ruten øverst til høyre den ene hvite ruten 2-eren fortsatt ser. **Høyreklikk** på den for å sette en prikk, slik markerer du en rute du vet blir hvit."
      },
      "step5": {
        "text": "Tallet **3** ser allerede seg selv og de to rutene til venstre, så ruten til høyre må være svart. **Klikk** på den."
      },
      "step6": {
        "text": "Ferdig med to svarte ruter — prikkene er bare notater. **H** fyller inn én rute som følger av resten, og **Løs** setter prikker i hele rutenettet.",
        "textTouch": "Ferdig med to svarte ruter — prikkene er bare notater. **Løs** setter prikker i hele rutenettet når du heller vil se svaret."
      }
