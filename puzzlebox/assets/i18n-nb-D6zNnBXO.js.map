  "tutorials": {
    "blackbox": {
      "step1": {
        "text": "Én kule gjemmer seg i denne 4×4-boksen. Skyt lasere inn fra prikkene rundt kanten, finn ut hvor den må være, merk den og klikk på knappen i hjørnet."
      },
      "step2": {
        "text": "Klikk på prikken på **venstre kant, på høyde med andre rad**. Strålen bøyes av på veien gjennom og kommer ut et annet sted; begge endene får samme tall."
      },
      "step3": {
        "text": "Skyt så fra prikken **øverst i andre kolonne**. En **H** betyr at strålen gikk rett inn i en kule og aldri kom ut."
      },
      "step4": {
        "text": "Skyt fra prikken **øverst i første kolonne** også. En **R** betyr at strålen spratt rett ut igjen, og det skjer når en kule ligger på skrå ved siden av porten."
      },
      "step5": {
        "text": "R-en gir en kule på skrå ved første kolonne, og H-en gir en rett nedover den andre: bare denne ruten oppfyller begge deler."
      },
      "step6": {
        "text": "**Klikk på den ruten** for å merke kulen din der."
      },
      "step7": {
        "text": "Alle kulene er merket, så **haken øverst til venstre** er aktiv. Klikk på den for å få svaret sjekket."
      },
      "step8": {
        "text": "Riktig. Underveis kan du **høyreklikke** på en rute for å låse den når du er sikker på at den er tom, og **Løs** røper svaret."
      }
    },
    "bridges": {
      "step1": {
        "text": "Tallet på hver øy sier hvor mange broer som skal ende der. Koble alle øyene sammen til ett nettverk, med høyst to broer mellom to øyer og ingen broer som krysser hverandre."
      },
      "step2": {
        "text": "**2-tallet nederst** har bare én øy på linje med seg: **4-tallet** øverst. **Dra** fra 2-tallet mot 4-tallet for å slå en bro over."
      },
      "step3": {
        "text": "Den skal ha to broer, og disse to øyene er det eneste stedet de kan gå. **Dra** på samme måte en gang til for å legge en parallell bro nummer to."
      },
      "step4": {
        "text": "Denne øyen er i mål. **Klikk** på den for å merke den som ferdig: den blir grå, og broene låses, så du ikke kommer borti dem ved et uhell."
      },
      "step5": {
        "text": "Ingen bro kan krysse en annen, så linjen mellom **de to 1-tallene** er død nå. **Dra med høyre knapp** fra 1-tallet til venstre mot det til høyre for å notere det."
      },
      "step6": {
        "text": "Hvert 1-tall har nå bare én vei ut, og de fire siste broene følger av det. **Løs** gjør puslespillet ferdig (og **G** viser hver linje en bro kan følge).",
        "textTouch": "Hvert 1-tall har nå bare én vei ut, og de fire siste broene følger av det. **Løs** gjør puslespillet ferdig."
      }
    },
    "cube": {
      "step1": {
        "text": "Terningen har seks flater, og seks ruter er malt blå. Rull den rundt til hver flate har samlet én: hver gang den lander, bytter flaten under og ruten farge."
      },
      "step2": {
        "text": "Et klikk vipper terningen over kanten mot ruten du velger. **Klikk på den blå ruten rett under terningen** for å få fargen over på flaten som lander."
      },
      "step3": {
        "text": "Ruten den forlot, er blank nå — fargene bytter virkelig plass. **Klikk på den blå ruten til høyre** for å gjøre flate nummer to blå."
      },
      "step4": {
        "text": "**Piltastene** ruller terningen også. Trykk på **→** én gang for å plukke opp den tredje blå ruten.",
        "textTouch": "Hver naborute er ett trykk unna. **Trykk på den neste blå ruten til høyre** for å plukke opp den tredje blå ruten."
      },
      "step5": {
        "text": "Tre flater blå, tre igjen — dette brettet kan klares på seks rull i alt, og statuslinjen teller dem. **Angre** tar ett tilbake hvis du ruller for langt."
      }
    },
    "dominosa": {
      "step1": {
        "text": "Tre dominoer — 0-0, 0-1 og 1-1 — ble lagt ut her og så tatt bort, slik at bare tallene står igjen. Del rutenettet i par, og legg hver av dem tilbake nøyaktig én gang."
      },
      "step2": {
        "text": "Ingen domino kan brukes to ganger. Å pare denne **0**-en med **1**-eren under ville gjort begge ytterkolonnene til en 0-1, så **høyreklikk** mellom dem for å notere at de ikke hører sammen."
      },
      "step3": {
        "text": "De eneste to **0**-ene som ligger inntil hverandre, er paret i øverste venstre hjørne, så det er der 0-0 hører hjemme. **Klikk på grensen mellom dem** for å legge den."
      },
      "step4": {
        "text": "På samme måte er de eneste **1**-erne som rører hverandre, de to nede til venstre. Klikk på grensen mellom dem for å legge 1-1."
      },
      "step5": {
        "text": "Da er høyre kolonne igjen til 0-1. Klikk på grensen mellom de to tallene der for å bli ferdig."
      },
      "step6": {
        "text": "Hver domino er brukt én gang. Klikk på en domino igjen for å løfte den av. En domino som er brukt to ganger, tegnes i rødt, og **Angre** tar deg tilbake gjennom trekkene."
      }
    },
    "fifteen": {
      "step1": {
        "text": "Skyv de nummererte brikkene inn i den tomme ruten til de står i rekkefølge fra **1 til 8**, med hullet nederst til høyre. Dette lille brettet er to trekk fra å være løst."
      },
      "step2": {
        "text": "Alle brikker i samme rad eller kolonne som hullet kan skyves. Klikk på **5** for å skyve den opp i hullet."
      },
      "step3": {
        "text": "Én til. Klikk på **8** for å fullføre raden."
      },
      "step4": {
        "text": "Løst! **Angre** og **Gjør om** går gjennom trekkene dine, og **Nytt** i pausemenyen gir deg et nytt puslespill. Piltastene skyver også en brikke inn i hullet, i pilens retning.",
        "textTouch": "Løst! **Angre** og **Gjør om** går gjennom trekkene dine, og **Nytt** i pausemenyen gir deg et nytt puslespill. En hel rad eller kolonne skyves om gangen, så sikt på den ytterste brikken."
      }
    },
    "filling": {
      "step1": {
        "text": "Skriv et siffer i hver tomme rute slik at hver sammenhengende blokk av like sifre dekker nøyaktig så mange ruter som sifferet sier."
      },
      "step2": {
        "text": "**3**-tallet nederst i midtkolonnen kan bare vokse oppover, så blokken er hele den kolonnen. **Dra** fra den øverste ruten i den ned til den midterste, og trykk så på **3**.",
        "textTouch": "**3**-tallet nederst i midtkolonnen kan bare vokse oppover. **Dra** fra den øverste ruten i den ned til den midterste, og trykk så på **3** på tastene."
      },
      "step3": {
        "text": "**2**-tallet i venstre kolonne mangler én makker, og ruten over er den eneste ledige. Klikk på den ruten og trykk på **2**.",
        "textTouch": "**2**-tallet i venstre kolonne mangler én makker, og ruten over er den eneste ledige. Trykk på den ruten, og trykk så på **2** på tastene."
      },
      "step4": {
        "text": "Én rute igjen. Klikk på den og trykk på **1** for å se hvordan et galt siffer ser ut.",
        "textTouch": "Én rute igjen. Trykk på den, og trykk så på **1** på tastene for å se hvordan et galt siffer ser ut."
      },
      "step5": {
        "text": "Rødt betyr umulig: de to **1**-tallene berører hverandre og ville blitt en blokk på to, og **2**-tallet øverst er stengt inne. Ruten er fortsatt valgt, så trykk på **Backspace** for å tømme den.",
        "textTouch": "Rødt betyr umulig: de to **1**-tallene berører hverandre og ville blitt en blokk på to, og **2**-tallet øverst er stengt inne. Ruten er fortsatt valgt, så trykk på **⌫** på tastene for å tømme den."
      },
      "step6": {
        "text": "Den tomme ruten hører sammen med **2**-tallet over den i stedet. Klikk på den og trykk på **2** for å fullføre rutenettet.",
        "textTouch": "Den tomme ruten hører sammen med **2**-tallet over den i stedet. Trykk på den, og trykk så på **2** på tastene for å fullføre rutenettet."
      },
      "step7": {
        "text": "Fylt. Tykke streker rammer inn hver ferdige blokk; **høyreklikker du**, legges ruter til utvalget én om gangen, og **Angre** tar tilbake en utfylling."
      }
    },
    "flip": {
      "step1": {
        "text": "Tenn alle de ni rutene. Trykker du på én, vendes den **og** rutene rundt, så tente ruter kan bli mørke igjen."
      },
      "step2": {
        "text": "Den lille figuren inni en rute viser hva den vender: den fylte blokken er ruten selv, omrissene er naboene."
      },
      "step3": {
        "text": "På tide å tenne dette brettet. Trykk på ruten **øverst til venstre**, den mørke i hjørnet."
      },
      "step4": {
        "text": "Hjørnet lyser, men de to naboene ble mørke. Trykk på ruten i **midten** nå."
      },
      "step5": {
        "text": "Nå er bare hjørnet nederst til høyre mørkt. Trykk på ruten **nederst til høyre** for å fullføre."
      },
      "step6": {
        "text": "Alt lyser! **Angre** tar tilbake et trykk, og du kan styre en markør med piltastene og trykke Enter i stedet for å klikke.",
        "textTouch": "Alt lyser! **Angre** tar tilbake et trykk, og to trykk på samme rute opphever alltid hverandre, så rekkefølgen spiller ingen rolle."
      }
    },
    "flood": {
      "step1": {
        "text": "Ruten øverst til venstre er din, sammen med alt som henger sammen med den i samme farge. Hvert trekk maler om hele flekken, så naboruter i den nye fargen blir med. Gjør hele rutenettet ensfarget innenfor grensen på **fire trekk**."
      },
      "step2": {
        "text": "Flekken din er foreløpig bare det blå hjørnet. Klikk på den **røde** ruten ved siden av: flekken blir rød, og alle røde ruter den rører ved, blir med."
      },
      "step3": {
        "text": "Klikk nå på en **blå** rute i kanten av flekken din. En godt valgt farge kan spre seg langt utover rutenettet på ett trekk."
      },
      "step4": {
        "text": "Bare **grønn** er igjen utenfor flekken din. Ett klikk til tar med resten av rutenettet."
      },
      "step5": {
        "text": "Tre trekk av fire — statuslinjen holder tellingen. Går du tom før rutenettet er ensfarget, er runden tapt. Står du fast? Et **Hint** spiller én god farge for deg, og **Løs** gjør ferdig rutenettet — det teller som løst automatisk."
      }
    },
    "galaxies": {
      "step1": {
        "text": "To prikker, altså to galakser. Tegn vegger langs linjene i rutenettet slik at hver prikk havner midt i sitt eget område: dreier du et område 180° om prikken, må det lande nøyaktig oppå seg selv."
      },
      "step2": {
        "text": "Den venstre prikken ligger på en linje mellom to ruter, så galaksen dens må være de to venstre kolonnene. **Klikk** på linjen like til høyre for dem, i **øverste rad**."
      },
      "step3": {
        "text": "Prikkene fungerer også som notatblokk. **Dra** fra den høyre prikken inn i **ruten øverst til høyre** for å legge igjen en pil der, som merker ruten som en del av galaksen dens."
      },
      "step4": {
        "text": "Tilbake til veggen: **klikk** på den samme linjen én rad lenger ned, i **midterste rad**."
      },
      "step5": {
        "text": "Ett stykke gjenstår, i **nederste rad**. **Klikk** på det for å lukke begge galaksene."
      },
      "step6": {
        "text": "Begge områdene er skravert, så begge er riktige. **Løs** tegner hele løsningen, og et klikk på en vegg visker den ut igjen."
      }
    },
    "guess": {
      "step1": {
        "text": "To pinner er skjult bak spørsmålstegnene, i en eller annen rekkefølge av tre farger. Gjett en rad, les merkene den gir, og snevre inn mulighetene."
      },
      "step2": {
        "text": "**Dra** den øverste fargen ut av paletten og slipp den i **det venstre hullet** i raden med pilen."
      },
      "step3": {
        "text": "Du kan også velge en farge først og klikke på hullene med den. Klikk på **den andre fargen** i paletten."
      },
      "step4": {
        "text": "Klikk nå på **det høyre hullet** for å legge fargen der."
      },
      "step5": {
        "text": "Raden er full, så **den stiplede boksen** til høyre lyser opp. Klikk på den for å få gjettet vurdert."
      },
      "step6": {
        "text": "To **hule** merker betyr at begge fargene er med i svaret, men at ingen av dem står på riktig plass — et fylt merke ville vært riktig farge på riktig plass. Bytt om på dem og send inn igjen."
      },
      "step7": {
        "text": "Løst. **Løs** gir opp og viser svaret, og **L**-tasten setter bokstaver på pinnene hvis fargene er vanskelige å skille.",
        "textTouch": "Løst. **Løs** gir opp og viser svaret, og **Behold** ved siden av Angre holder en pinne du stoler på, på plass til neste gjett."
      }
    },
    "inertia": {
      "step1": {
        "text": "Du er ballen i øvre venstre hjørne, og det er **tre juveler** å samle. Så snart ballen begynner å rulle, stopper den bare ved en vegg eller en stoppkloss — og en mine tar livet av den."
      },
      "step2": {
        "text": "Klikk på en rute til **høyre** for ballen. Den ruller den veien til kanten av brettet stopper den, og feier med seg juvelen den passerer."
      },
      "step3": {
        "text": "Klikk nå **under** ballen. Den tar den neste juvelen, og den brutte ringen to ruter ned — en stoppkloss — får den til å stanse."
      },
      "step4": {
        "text": "Pass på: den piggete tingen rett under ballen er en **mine**. Ruller du inn på en, er spillet slutt, og bare Angre får deg ut av det."
      },
      "step5": {
        "text": "Gå **diagonalt** i stedet: klikk på ruten to ned og to til venstre, så glir ballen forbi minen og bort til den siste juvelen."
      },
      "step6": {
        "text": "Alle tre juvelene — ferdig. **Angre** spoler tilbake et rull som gikk galt; piltastene ruller rett, og Home, Page Up, End og Page Down ruller diagonalt.",
        "textTouch": "Alle tre juvelene — ferdig. **Angre** spoler tilbake et rull som gikk galt, og du kan også trykke utenfor rutenettet, noe som hjelper når ballen ligger inntil en kant."
      }
    },
    "keen": {
      "step1": {
        "text": "Fyll inn 1, 2 og 3 slik at hvert tall står én gang i hver rad og kolonne, og slik at sifrene i hvert tykt innrammede bur stemmer med regnestykket til buret."
      },
      "step2": {
        "text": "I **2×**-buret er produktet 2, så sifrene der er 1, 1 og 2. Et bur kan gjenta et siffer, men ikke i samme rad eller kolonne, så 2-tallet hører hjemme i hjørnet: klikk på den ruten og skriv **2**.",
        "textTouch": "I **2×**-buret er produktet 2, så sifrene der er 1, 1 og 2. 2-tallet hører hjemme i hjørnet: trykk på den ruten, og trykk så på **2** på tastene."
      },
      "step3": {
        "text": "De to andre rutene i buret er 1-tallene. Klikk på ruten **til høyre for 2-tallet** og skriv **1**.",
        "textTouch": "De to andre rutene i buret er 1-tallene. Trykk på ruten **til høyre for 2-tallet**, og trykk så på **1** på tastene."
      },
      "step4": {
        "text": "Øverste rad har allerede 2-tallet og 1-tallet sitt, så den siste ruten der må være 3-tallet. Klikk på **ruten øverst til høyre** og skriv **3**.",
        "textTouch": "Øverste rad har allerede 2-tallet og 1-tallet sitt, så den siste ruten der må være 3-tallet. Trykk på **ruten øverst til høyre**, og trykk så på **3** på tastene."
      },
      "step5": {
        "text": "Gjetter du bare på en rute? **Høyreklikk** på midtruten og skriv **3** for å føre sifferet inn som et blyantnotat i stedet for å fylle det inn.",
        "textTouch": "Gjetter du bare på en rute? **Trykk lenge** på midtruten og trykk på **3** for å notere sifferet i stedet for å fylle det inn. **✎**-tasten gjør det samme for en rute du har trykket på."
      },
      "step6": {
        "text": "Regn ut resten på samme måte; et siffer som gjentas i raden eller kolonnen sin, blir rødt, og det samme gjør et fullt bur som ikke stemmer med regnestykket sitt. I pausemenyen fører **Merker** inn alle muligheter som blyantnotater for deg, og **Løs** røper svaret."
      }
    },
    "lightup": {
      "step1": {
        "text": "Hver hvite rute må ende opp opplyst. En pære lyser opp sin egen rad og kolonne helt til en svart rute stopper strålen, og ingen pære får stå i lyset fra en annen."
      },
      "step2": {
        "text": "Et tall sier hvor mange pærer som ligger inntil den svarte ruten. Dette **2-tallet** har bare to hvite naboer, så begge må ha en pære: klikk på den til **høyre**."
      },
      "step3": {
        "text": "Legg merke til det gule skjæret som brer seg langs strålen. Klikk nå på ruten rett **under** 2-tallet for å sette pære nummer to."
      },
      "step4": {
        "text": "En **0** har ingen pærer inntil seg i det hele tatt. **Høyreklikk** på ruten over den for å sette et kryss: det minner deg bare om at det ikke kan stå en pære der."
      },
      "step5": {
        "text": "**1-tallet** vil ha nøyaktig én pære. Ruten under det er allerede opplyst, så en pære der ville stått i strålen — klikk på ruten til **venstre** for 1-tallet i stedet."
      },
      "step6": {
        "text": "To ruter i øverste rad er fortsatt mørke, og den ene har du krysset av. Klikk på **den andre**."
      },
      "step7": {
        "text": "Alle ruter opplyst, alle tall fornøyde. **Angre** tar tilbake en pære, og piltastene sammen med Enter og mellomrom setter pærer og kryss uten mus.",
        "textTouch": "Alle ruter opplyst, alle tall fornøyde. **Angre** tar tilbake en pære, og et langt trykk krysser av ruter du har utelukket."
      }
    },
    "loopy": {
      "step1": {
        "text": "Tegn **én** lukket løkke langs de svake strekene mellom prikkene. Hvert tall sier hvor mange av rutens fire sider løkken bruker."
      },
      "step2": {
        "text": "Midtruten er merket **4**, så alle fire sidene er med i løkken. **Klikk** på den øverste siden for å tegne den første streken."
      },
      "step3": {
        "text": "Så den **venstre siden**. Klikker du på en strek igjen, viskes den ut."
      },
      "step4": {
        "text": "Hver prikk har to streker eller ingen, og prikken der de to møtes, er full. **Høyreklikk** på streken som går opp derfra, for å krysse den ut som ubrukelig."
      },
      "step5": {
        "text": "To sider igjen. **Klikk** på den nederste siden av midtruten."
      },
      "step6": {
        "text": "Og den **høyre siden** lukker den. Én løkke, ingen løse ender, og de fire **0**-tallene holder seg helt unna."
      },
      "step7": {
        "text": "Løst. **Angre** går tilbake gjennom strekene dine, og **Type** i pausemenyen bytter rutene ut med trekanter, sekskanter og enda rarere mønstre."
      }
    },
    "magnets": {
      "step1": {
        "text": "Hver domino er enten en magnet, med en **+**-halvdel og en **−**-halvdel, eller tom. Tallene teller **+**-polene (øverst og til venstre) og **−**-polene (nederst og til høyre) i hver linje, og like poler må aldri berøre hverandre."
      },
      "step2": {
        "text": "Nederste rad skal ha tre **−**-poler, og bare tre dominoer når ned i den, så hver må gi én. **Venstreklikk** på den øverste halvdelen av den stående dominoen for å gjøre den **+**, slik at **−** havner nedenfor."
      },
      "step3": {
        "text": "Da er den brede dominoen nederst til høyre også en magnet, og **0**-tallet over siste kolonne forbyr en **+** der. **Venstreklikk** på venstre halvdel for å legge **+** på den siden."
      },
      "step4": {
        "text": "Fjerde kolonne har nå sin ene **+** og skal ikke ha noen **−** i det hele tatt, så dominoen over kan ikke være noen av delene. **Høyreklikk** på den for å merke den som tom."
      },
      "step5": {
        "text": "Øverste rad mangler fortsatt en **+** og en **−** fra den brede dominoen til venstre. Høyre halvdel berører en **+**, og like poler kan ikke berøre hverandre — så **venstreklikk** på venstre halvdel."
      },
      "step6": {
        "text": "Én domino igjen. Første kolonne har brukt opp sin **+** øverst, så **+** her hører hjemme til høyre: **venstreklikk** på høyre halvdel for å bli ferdig."
      },
      "step7": {
        "text": "Løst! Klikker du på samme halvdel igjen, snus magneten rundt; høyreklikker du en gang til, står det igjen spørsmålstegn som notat om «magnet, men hvilken vei?», og **Angre** går et skritt tilbake."
      }
    },
    "map": {
      "step1": {
        "text": "Fargelegg hvert område slik at to områder som deler en grensestrekning, aldri får samme farge. Fire farger er alltid nok, og tre områder her er fortsatt tomme."
      },
      "step2": {
        "text": "Plukk opp en farge først: **klikk** på den **blå fargeprøven**, nummer to i raden under kartet."
      },
      "step3": {
        "text": "Med en farge i hånden kan du **høyreklikke** på et tomt område for å sette inn en liten prikk i den fargen — et notat om at området *kanskje* har den fargen. Prøv det på det høye området langs høyre side."
      },
      "step4": {
        "text": "Det er mer enn et kanskje: området grenser allerede til rødt, grønt og gult, så blått er det eneste som er igjen. **Klikk** på det for å fargelegge det."
      },
      "step5": {
        "text": "Du kan også **dra** en farge fra ett område til et annet. Det store området øverst berører nå rødt, grønt og blått, så **dra** gult opp dit fra det lille området nederst."
      },
      "step6": {
        "text": "Ett tomt område igjen, i **nedre venstre hjørne**: det grenser til grønt, blått og det nye gule, så det må være rødt. **Dra** rødt ned dit fra området i øvre høyre hjørne."
      },
      "step7": {
        "text": "Ferdig — en kollisjon ville vist et rødt **!** på grensen mellom de to områdene. **Angre** går tilbake, og piltastene sammen med **1**–**4** fargelegger helt uten mus.",
        "textTouch": "Ferdig — en kollisjon ville vist et rødt **!** på grensen mellom de to områdene. **Angre** går tilbake, og viskelæret ytterst i raden tømmer et område du har ombestemt deg om."
      }
    },
    "mines": {
      "step1": {
        "text": "Hvert tall teller minene i de åtte rutene som rører det. To miner ligger skjult i den tildekkede blokken; avdekk alt annet uten å trå på en av dem."
      },
      "step2": {
        "text": "Denne **1**-eren rører bare én tildekket rute, så den ruten er en mine. **Høyreklikk** på den for å sette et flagg."
      },
      "step3": {
        "text": "**1**-eren under har nå den ene minen sin flagget, så resten av naboene er trygge. **Venstreklikk på det 1-tallet** for å åpne dem i én omgang."
      },
      "step4": {
        "text": "**2**-eren over blokken teller allerede ett flagg og har bare én tildekket rute igjen. **Høyreklikk** på den ruten."
      },
      "step5": {
        "text": "Begge minene er flagget, så den siste tildekkede ruten må være trygg. **Venstreklikk** på den for å gjøre rutenettet ferdig."
      },
      "step6": {
        "text": "Ryddet! Høyreklikker du på ruten igjen, fjernes flagget, og **Angre** redder deg hvis du skulle trå på en mine."
      }
    },
    "net": {
      "step1": {
        "text": "Hver brikke har en bit ledning, og hele nettet er dreid rundt tilfeldig. Drei brikkene til alle ni henger sammen med den merkede brikken i midten: **blå** ledninger har strøm, grå har det ikke."
      },
      "step2": {
        "text": "Brikken nederst til venstre peker ledningen rett inn i veggen. **Venstreklikk** på den for en kvart omdreining mot klokken, så ledningen når naboen til høyre."
      },
      "step3": {
        "text": "**Et høyreklikk** dreier en brikke andre veien. Gi brikken nederst til høyre én omdreining med klokken, så svinger ledningen rundt til venstre."
      },
      "step4": {
        "text": "Midtbrikken har ledninger på alle fire sider, så den kan ikke være feil. **Midtklikk** på den for å låse den, eller slå på **hengelåsen** ved siden av Angre og klikk på den: en låst brikke er skravert og nekter å dreie.",
        "textTouch": "Midtbrikken har ledninger på alle fire sider, så den kan ikke være feil. Slå på **hengelåsen** ved siden av Angre og trykk på brikken for å låse den: en låst brikke er skravert og nekter å dreie."
      },
      "step5": {
        "text": "Én brikke igjen. Slå av **hengelåsen** og **venstreklikk** på brikken øverst til høyre for å svinge ledningen dens mot venstre og gi strøm til hele nettet.",
        "textTouch": "Én brikke igjen. Slå av **hengelåsen** og trykk på brikken øverst til høyre for å svinge ledningen dens mot venstre og gi strøm til hele nettet."
      },
      "step6": {
        "text": "Alle ni brikkene har strøm. **Angre** går tilbake gjennom dreiningene dine; med tastaturet flytter piltastene en markør, og **A**, **D** og **F** dreier brikken under den.",
        "textTouch": "Alle ni brikkene har strøm. **Angre** går tilbake gjennom dreiningene dine, en brikke du låser, er trygg mot bomtrykk, og **Bland** snurrer alle ulåste brikker på nytt."
      }
