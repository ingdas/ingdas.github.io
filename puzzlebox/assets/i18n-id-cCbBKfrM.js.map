    "guess": {
      "step1": {
        "text": "Dua pasak tersembunyi di balik tanda tanya, tersusun dari tiga warna. Tebak satu baris, baca tanda yang kamu dapat, lalu persempit kemungkinannya."
      },
      "step2": {
