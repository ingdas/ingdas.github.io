  "tutorials": {
    "blackbox": {
      "step1": {
        "text": "Satu bola bersembunyi di dalam kotak 4×4 ini. Tembakkan laser dari titik-titik di sekeliling tepi, simpulkan di mana bolanya, tandai, lalu tekan tombol di sudut."
      },
      "step2": {
        "text": "Klik titik di **tepi kiri, sejajar dengan baris kedua**. Sinarnya dibelokkan di tengah jalan dan keluar di tempat lain; kedua ujungnya diberi angka yang sama."
      },
      "step3": {
        "text": "Sekarang tembakkan titik di **atas kolom kedua**. Huruf **H** berarti sinarnya menabrak bola dan tidak pernah keluar."
      },
      "step4": {
        "text": "Tembakkan juga titik di **atas kolom pertama**. Huruf **R** berarti sinarnya memantul balik keluar, yang terjadi kalau ada bola persis diagonal di samping lubangnya."
      },
      "step5": {
        "text": "R menaruh bola secara diagonal di sebelah kolom pertama, dan H menaruhnya lurus di bawah kolom kedua: hanya kotak ini yang memenuhi keduanya."
      },
      "step6": {
        "text": "**Klik kotak itu** untuk menandai bolamu di sana."
      },
      "step7": {
        "text": "Semua bola sudah ditandai, jadi **tanda centang di sudut kiri atas** kini aktif. Klik untuk memeriksa jawabanmu."
      },
      "step8": {
        "text": "Benar. Selama bermain, **klik kanan** sebuah kotak untuk menguncinya begitu kamu yakin kotak itu kosong, dan **Pecahkan** langsung menunjukkan jawabannya."
      }
    },
    "bridges": {
      "step1": {
        "text": "Angka di setiap pulau adalah jumlah ujung jembatan yang diinginkannya. Gabungkan semua pulau menjadi satu jaringan, paling banyak dua jembatan antar sepasang pulau dan tidak ada jembatan yang bersilangan."
      },
      "step2": {
        "text": "**Angka 2 di bawah** hanya punya satu pulau yang segaris dengannya: **angka 4** di atas. **Seret** dari 2 ke arah 4 untuk membentangkan sebuah jembatan."
      },
      "step3": {
        "text": "Pulau itu butuh dua ujung jembatan, dan pasangan itu satu-satunya tempat yang mungkin. **Seret** sekali lagi dengan cara yang sama untuk jembatan kedua yang sejajar."
      },
      "step4": {
        "text": "Pulau itu selesai. **Klik** pulaunya untuk menandainya tuntas: warnanya jadi abu-abu dan jembatannya terkunci, jadi kamu tidak akan mengusiknya tanpa sengaja."
      },
      "step5": {
        "text": "Jembatan tidak boleh bersilangan, jadi garis antara **kedua angka 1** kini tertutup. **Seret dengan tombol kanan** dari 1 di kiri ke arah 1 di kanan untuk menandainya."
      },
      "step6": {
        "text": "Kini masing-masing 1 punya satu jalan keluar, dan empat jembatan sisanya mengikuti dari situ. **Pecahkan** menuntaskan teka-tekinya (dan **G** menampilkan setiap garis yang bisa dilalui jembatan).",
        "textTouch": "Kini masing-masing 1 punya satu jalan keluar, dan empat jembatan sisanya mengikuti dari situ. **Pecahkan** menuntaskan teka-tekinya."
      }
    },
    "cube": {
      "step1": {
        "text": "Kubus punya enam sisi dan enam kotak diwarnai biru. Gulingkan kubusnya sampai setiap sisi mengumpulkan satu warna: setiap kali mendarat, sisi yang di bawah dan kotaknya bertukar warna."
      },
      "step2": {
        "text": "Klik untuk menggulingkan kubus ke arah kotak yang kamu pilih. **Klik kotak biru tepat di bawah kubus** untuk memindahkan warnanya ke sisi yang mendarat."
      },
      "step3": {
        "text": "Kotak yang ditinggalkan kini polos — warnanya benar-benar bertukar. **Klik kotak biru di sebelah kanan** untuk membuat sisi kedua menjadi biru."
      },
      "step4": {
        "text": "**Tombol panah** juga menggulingkan kubus. Tekan **→** sekali untuk memungut kotak biru ketiga.",
        "textTouch": "Setiap kotak tetangga hanya berjarak satu ketukan. **Ketuk kotak biru berikutnya di sebelah kanan** untuk memungut kotak biru ketiga."
      },
      "step5": {
        "text": "Tiga sisi biru, tiga lagi — papan ini bisa dituntaskan dalam enam gulingan, dan baris status menghitungnya. **Urungkan** membatalkan satu langkah kalau kamu kebablasan."
      }
    },
    "dominosa": {
      "step1": {
        "text": "Tiga kartu domino — 0-0, 0-1, dan 1-1 — pernah disusun di sini lalu diangkat, meninggalkan angka-angkanya. Bagi kisinya menjadi pasangan-pasangan untuk mengembalikan masing-masing tepat sekali."
      },
      "step2": {
        "text": "Tidak ada domino yang boleh dipakai dua kali. Memasangkan **0** ini dengan **1** di bawahnya akan membuat kedua kolom terluar menjadi 0-1, jadi **klik kanan** di antara keduanya untuk mencatat bahwa mereka bukan pasangan."
      },
      "step3": {
        "text": "Satu-satunya pasangan **0** yang bersentuhan ada di sudut kiri atas, jadi di situlah 0-0 berada. **Klik batas di antara keduanya** untuk memasangnya."
      },
      "step4": {
        "text": "Begitu pula, satu-satunya pasangan **1** yang bersentuhan ada di kiri bawah. Klik batas di antara keduanya untuk 1-1."
      },
      "step5": {
        "text": "Sisanya kolom kanan untuk 0-1. Klik batas di antara kedua angkanya untuk menyelesaikannya."
      },
      "step6": {
        "text": "Setiap domino terpakai sekali. Klik lagi sebuah domino untuk mengangkatnya, domino yang berulang digambar merah, dan **Urungkan** membatalkan langkahmu satu per satu."
      }
    },
    "fifteen": {
      "step1": {
        "text": "Geser ubin bernomor ke ruang kosong sampai terbaca **1 sampai 8** berurutan, dengan celah di sudut kanan bawah. Papan kecil ini tinggal dua langkah lagi."
      },
      "step2": {
        "text": "Ubin mana pun yang sebaris atau sekolom dengan celah bisa digeser. Klik **5** untuk mendorongnya naik ke celah."
      },
      "step3": {
        "text": "Satu lagi. Klik **8** untuk menuntaskan barisnya."
      },
      "step4": {
        "text": "Terpecahkan! **Urungkan** dan **Ulangi** menelusuri langkah-langkahmu, dan **Baru** di menu jeda memberimu teka-teki baru. Tombol panah juga bisa menggeser ubin ke dalam celah, searah dengan panahnya.",
        "textTouch": "Terpecahkan! **Urungkan** dan **Ulangi** menelusuri langkah-langkahmu, dan **Baru** di menu jeda memberimu teka-teki baru. Satu baris atau kolom bisa bergeser sekaligus, jadi incar ubin yang paling jauh."
      }
    },
    "filling": {
      "step1": {
        "text": "Tulis satu angka di setiap kotak kosong sehingga setiap blok angka sama yang tersambung terdiri atas kotak persis sebanyak angkanya."
