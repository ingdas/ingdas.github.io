    "range": {
      "step1": {
        "text": "Tô đen các ô sao cho mỗi con số đếm đúng số ô trắng mà ô của nó nhìn thấy: chính nó, cộng với mọi ô thẳng hàng lên, xuống, trái, phải cho đến khi gặp ô đen hoặc mép lưới."
      },
      "step2": {
        "text": "Số **6** lúc này nhìn thấy sáu ô — cả hàng của nó cộng với hai ô bên dưới. Vậy không ô nào trong hàng hay cột đó được tô đen."
      },
      "step3": {
        "text": "Số **2** chỉ được thấy chính nó và thêm một ô, mà ô phía trên nó phải giữ trắng cho số 6. Vậy hãy **nhấp** vào ô bên trái nó để tô đen."
      },
      "step4": {
        "text": "Vậy ô trên cùng bên phải là ô trắng duy nhất số 2 còn nhìn thấy. **Nhấp chuột phải** vào nó để ghi chú một dấu chấm, cách ghi lại một ô bạn biết chắc vẫn trắng."
      },
      "step5": {
        "text": "Số **3** đã nhìn thấy chính nó và hai ô bên trái, nên ô bên phải nó phải đen. **Nhấp** vào ô đó."
      },
      "step6": {
        "text": "Xong với hai ô đen — các dấu chấm chỉ là ghi chú. **H** điền một ô suy ra được từ phần còn lại, còn **Giải** chấm kín cả lưới.",
        "textTouch": "Xong với hai ô đen — các dấu chấm chỉ là ghi chú. **Giải** chấm kín cả lưới khi bạn muốn xem đáp án."
      }
    },
    "rect": {
      "step1": {
        "text": "Cắt lưới này thành các hình chữ nhật sao cho mỗi hình chứa đúng một con số, và con số đó bằng số ô hình chữ nhật phủ."
      },
      "step2": {
        "text": "Mỗi hình chữ nhật chỉ chứa một con số, mà số **3** lại nằm ngay dưới số **4** — nên số 4 phải lấy cả hàng trên cùng. **Kéo** từ số 4 sang đầu bên phải của hàng đó."
      },
      "step3": {
        "text": "Nhấp vào một đường lưới sẽ thêm hoặc bỏ đúng cạnh đó. **Nhấp** vào đường ở bên phải số **3**."
      },
      "step4": {
        "text": "Số 9 chỉ có thể là một khối 3×3, và chỉ còn một chỗ cho nó. **Kéo** qua khối được làm nổi bật, từ ô trên cùng bên trái tới góc dưới bên phải: việc này cũng khoanh luôn số 3 lại."
      },
      "step5": {
        "text": "Mọi ô đều nằm trong một hình chữ nhật đúng kích thước. **Kéo chuột phải** sẽ xóa các đường bên trong một vùng nhưng giữ lại đường bao, và **Hoàn tác** lấy lại một nét vẽ."
      }
    },
    "samegame": {
      "step1": {
        "text": "Dọn sạch bàn chơi bằng cách lấy đi các nhóm từ hai ô cùng màu nằm sát nhau trở lên. Một nhóm _n_ ô được (_n_ − 2)² điểm, nên nhóm lớn mới đáng giá."
      },
      "step2": {
        "text": "Nhấp vào một trong bốn ô **đỏ** ở hàng trên cùng. Cú nhấp đầu tiên chỉ chọn nhóm: nhóm sáng lên và có viền đậm."
      },
      "step3": {
        "text": "Nhấp lại vào nhóm đã chọn để nhấc nó khỏi bàn chơi và ghi bốn điểm. Các ô phía trên chỗ trống sẽ rơi xuống, và cột trống sẽ kéo các cột bên cạnh dồn sang."
      },
      "step4": {
        "text": "Ô **xanh lá** này đứng một mình. Không ô nào bên cạnh cùng màu, nên nó không bao giờ được chọn — nó phải chờ đến khi bàn chơi dồn một ô cùng màu tới cạnh nó."
      },
      "step5": {
        "text": "Giờ đến **cặp xanh dương** được làm nổi bật ở đây. Nhấp vào một trong hai ô để chọn cả hai."
      },
      "step6": {
        "text": "Đổi ý rồi? **Nhấp chuột phải** vào vùng chọn để bỏ chọn — chưa có gì bị xóa cho đến khi bạn nhấp vào nó lần thứ hai."
      },
      "step7": {
        "text": "Trò chơi chỉ có vậy thôi. Bàn chơi nào cũng dọn sạch được, nên cứ tiếp tục — **Hoàn tác** tua lại khi bạn để sót một ô lẻ, và không có nút Giải nào cứu bạn đâu."
      }
    },
    "signpost": {
      "step1": {
        "text": "Mỗi ô mang một mũi tên. Hãy nối cả sáu ô thành một chuỗi đánh số **1 đến 6**, trong đó ô tiếp theo của mỗi ô nằm đâu đó dọc theo mũi tên của nó."
      },
      "step2": {
        "text": "Số **1** chỉ sang phải. **Kéo** từ nó vào ô bên phải để biến ô đó thành số 2."
      },
      "step3": {
        "text": "Số **3** tự móc vào, như mọi cặp số liên tiếp chỉ đúng hướng. Giờ hãy **kéo** ô dưới cùng bên phải vào ô bên trái nó."
      },
      "step4": {
        "text": "Cả hai ô đó chưa có số, nên cặp này được ghi là **a** và **a+1**. **Nhấp chuột phải** vào ô giữa của hàng dưới cùng để tách chúng ra."
      },
      "step5": {
        "text": "Số thật thì tốt hơn: **kéo** số **3** vào ô bên dưới nó, ô đó sẽ thành số 4."
      },
      "step6": {
        "text": "Mắt xích cuối: **kéo** số 4 đó vào ô bên trái nó. Ô đó thành số 5, và số 6 tự khép lại đường đi."
      },
      "step7": {
        "text": "Đã giải. **Kéo chuột phải** sẽ nối theo chiều ngược lại, từ một ô về ô đứng trước nó, còn **Giải** vẽ ra toàn bộ đường đi."
      }
    },
    "singles": {
      "step1": {
        "text": "Tô đen các ô cho đến khi không số nào lặp lại giữa các ô trắng của bất kỳ hàng hay cột nào. Hai ô đen không bao giờ được chung cạnh, và các ô trắng phải liền thành một vùng."
      },
      "step2": {
        "text": "Hai số **4** ở hàng này cách nhau một ô. Tô đen ô đó sẽ để cả hai số 4 cùng trắng, nên chính nó phải trắng — **nhấp chuột phải** vào nó để khoanh tròn."
      },
      "step3": {
        "text": "Số **3** được khoanh tròn đó chắc chắn trắng, và cột của nó còn một số 3 khác ở trên cùng. **Nhấp chuột trái** vào số trên cùng để tô đen."
      },
      "step4": {
        "text": "Ô đen không bao giờ chạm nhau, nên số **4** ngay bên phải nó vẫn trắng. **Nhấp chuột trái** vào số 4 còn lại ở cột cuối đó."
      },
      "step5": {
        "text": "Tương tự: số **2** ngay trên ô đen mới của bạn là trắng, và hàng của nó còn một số 2 khác ở tận bên trái. **Nhấp chuột trái** vào số đó."
      },
      "step6": {
        "text": "Còn một ô. Số **3** trên ô đen đó là trắng, nên số 3 kia ở chân cột phải bị loại. **Nhấp chuột trái** vào nó."
      },
      "step7": {
        "text": "Đã giải, và các ô trắng vẫn liền một khối. Vòng tròn chỉ là ghi chú, và **Hoàn tác** lùi lại từng nước của bạn."
      }
    },
    "sixteen": {
      "step1": {
        "text": "Xếp các mảnh theo thứ tự, **1 đến 9**, đọc từ trái sang phải. Các mũi tên quanh mép trượt cả một hàng hoặc cột đi một bước, và mảnh nào rơi ra sẽ quay lại ở phía bên kia."
      },
      "step2": {
        "text": "Nhấp vào mũi tên **phía trên cột thứ hai** để trượt cột đó lên một bước; việc này hoàn thành hàng giữa."
      },
      "step3": {
        "text": "Giờ hàng dưới cùng cần dịch sang phải. **Nhấp chuột phải** vào mũi tên **bên trái hàng dưới cùng**: nhấp chuột phải đẩy hàng theo chiều ngược lại."
      },
      "step4": {
        "text": "Nước cuối: nhấp vào mũi tên **bên trái hàng trên cùng** để trượt nó sang trái và hoàn thành lưới."
      },
      "step5": {
        "text": "Đúng thứ tự rồi! **Loại** trong menu tạm dừng có những lưới lớn hơn, và **Tùy chỉnh…** trong đó có thể xáo một lưới với số nước xáo trộn định sẵn để bạn gỡ lại."
      }
    },
    "slant": {
      "step1": {
        "text": "Vẽ một đường chéo qua mỗi ô. Mỗi con số trong vòng tròn đếm số đường chạm vào góc của nó, và các đường không bao giờ được khép thành vòng."
      },
      "step2": {
        "text": "Số **0** ở góc trên bên trái không muốn đường nào chạm vào, nên ô duy nhất của nó phải nghiêng theo chiều kia. **Nhấp chuột phải** vào ô đó để vẽ `/`."
      },
      "step3": {
        "text": "Số **4** cần một đường từ cả bốn ô quanh nó. **Nhấp chuột trái** vào ô phía trên bên trái nó — nhấp chuột trái vẽ `\\`."
      },
      "step4": {
        "text": "Ô phía trên bên phải số **4** thì phải nghiêng xuống về bên trái. **Nhấp chuột phải** vào nó để vẽ `/`."
      },
      "step5": {
        "text": "Số **1** ở mép trái đã có một đường duy nhất của nó, từ ô bên dưới. Vậy ô phía trên phải nghiêng ra xa: **nhấp chuột trái** vào nó để vẽ `\\`."
      },
      "step6": {
        "text": "Cứ tiếp tục như vậy. Con số nào không còn thỏa được sẽ chuyển đỏ, và đường nào nằm trong một vòng kín cũng vậy. **Giải** trong menu tạm dừng điền phần còn lại."
      }
    },
    "solo": {
      "step1": {
        "text": "Mỗi hàng, mỗi cột và mỗi **khối 2×2** có viền phải chứa 1, 2, 3 và 4, mỗi số đúng một lần. Lưới nhỏ này còn thiếu ba ô."
      },
      "step2": {
        "text": "**Khối** này đã có 2, 3 và 4, nên ô trống của nó chỉ có thể là **1**. Nhấp vào ô đó và nhấn phím **1**.",
        "textTouch": "**Khối** này đã có 2, 3 và 4, nên ô trống của nó chỉ có thể là **1**. Chạm vào ô đó, rồi chạm **1** trên bàn phím số."
      },
      "step3": {
        "text": "Chưa chắc về một ô? **Nhấp chuột phải** vào ô trống này và nhấn **2** để ghi chú bút chì chữ số đó.",
        "textTouch": "Chưa chắc về một ô? Chạm vào ô trống này, bật **✎** trên bàn phím số, rồi chạm **2** để ghi chú bút chì chữ số đó."
      },
      "step4": {
        "text": "Hàng của nó đã có 3, 4 và 1, nên ghi chú là đúng. **Nhấp chuột trái** vào cùng ô đó và nhấn **2** để điền đáp án.",
        "textTouch": "Hàng của nó đã có 3, 4 và 1, nên ghi chú là đúng. Ô vẫn đang được chọn, nên hãy chạm **✎** để tắt bút chì rồi chạm **2** để điền đáp án."
      },
      "step5": {
        "text": "Còn một ô. Hàng của nó đã có 4, 3 và 1 — nhấp vào nó và nhấn chữ số còn thiếu.",
        "textTouch": "Còn một ô. Hàng của nó đã có 4, 3 và 1 — chạm vào nó, rồi chạm chữ số còn thiếu trên bàn phím số."
      },
      "step6": {
        "text": "Đã giải! **Hoàn tác** lấy lại một chữ số sai, còn phím **M** ghi chú bút chì mọi khả năng vào mọi ô trống cùng lúc.",
        "textTouch": "Đã giải! **Hoàn tác** lấy lại một chữ số sai, còn **Ghi chú** trong menu tạm dừng ghi bút chì mọi khả năng vào mọi ô trống cùng lúc."
      }
    },
    "tents": {
      "step1": {
        "text": "Dựng một chiếc lều cạnh mỗi cái cây — ở trên, dưới, trái hoặc phải nó, không bao giờ chéo. Không hai lều nào được chạm nhau, và các con số đếm số lều trong mỗi hàng và cột."
      },
      "step2": {
        "text": "Số **0** ở cuối hàng thứ hai nghĩa là hàng đó không có lều nào. **Nhấp chuột phải** vào ô cạnh cái cây để đánh dấu là cỏ."
      },
      "step3": {
        "text": "Cột thứ ba cũng trống. **Kéo chuột phải** từ ô trên cùng của nó xuống hàng thứ ba để đánh dấu cỏ cả ba ô một lượt."
      },
      "step4": {
        "text": "Cây ở dưới cùng bên phải nằm trong góc, cạnh một cây khác, nên ô trống duy nhất kề nó là ô phía trên. **Nhấp chuột trái** vào ô đó để dựng lều."
      },
      "step5": {
        "text": "Lều đó làm đầy hàng thứ ba, nên cây ở mép trái cũng không thể cắm lều bên dưới. **Nhấp chuột trái** vào ô trên cùng bên trái."
      },
      "step6": {
        "text": "Còn một cái cây chưa có lều, và chỉ ô bên trái nó còn trống. **Nhấp chuột trái** vào đó để hoàn thành khu cắm trại."
      },
      "step7": {
        "text": "Đã giải! Nhấp lại vào lều hoặc dấu cỏ sẽ xóa nó, phím mũi tên cùng Enter và Space làm được việc tương tự, và **Hoàn tác** lùi lại một bước.",
        "textTouch": "Đã giải! Chạm lại vào lều hoặc dấu cỏ sẽ xóa nó, và **Hoàn tác** lùi lại một bước."
      }
    },
    "towers": {
      "step1": {
        "text": "Mỗi hàng và cột có một tòa tháp cho mỗi chiều cao, từ 1 đến 4. Một con số quanh mép đếm số tháp bạn **nhìn thấy** từ đó: tháp cao hơn che khuất mọi tháp thấp hơn phía sau nó."
      },
      "step2": {
        "text": "Số **1** ở bên phải hàng trên cùng nghĩa là từ phía đó chỉ nhìn thấy một tháp, nên tháp gần nhất phải là tháp cao nhất. Nhấp vào ô đó và nhấn **4**.",
        "textTouch": "Số **1** ở bên phải hàng trên cùng nghĩa là từ phía đó chỉ nhìn thấy một tháp, nên tháp gần nhất phải là tháp cao nhất. Chạm vào ô đó, rồi chạm **4** trên bàn phím số."
      },
      "step3": {
        "text": "Bạn có thể ghi chú các khả năng thay vì điền đáp án. **Nhấp chuột phải** vào ô trống ở đầu trái hàng trên cùng và nhấn **1**.",
        "textTouch": "Bạn có thể ghi chú các khả năng thay vì điền đáp án. Chạm vào ô trống ở đầu trái hàng trên cùng, bật **✎** trên bàn phím số và chạm **1**."
      },
      "step4": {
        "text": "Số **4** ở bên trái hàng cho biết cả bốn tháp đều nhìn thấy được, nên chúng tăng dần 1-2-3-4 từ phía đó. **Nhấp chuột trái** vào ô và nhấn **1** để điền đáp án.",
        "textTouch": "Số **4** ở bên trái hàng cho biết cả bốn tháp đều nhìn thấy được, nên chúng tăng dần 1-2-3-4 từ phía đó. Ô vẫn đang được chọn, nên hãy chạm **✎** để tắt bút chì rồi chạm **1** để điền đáp án."
      },
      "step5": {
        "text": "Còn một ô, và số **1** bên cạnh hàng của nó lại đặt tháp cao nhất ở gần nhất. Nhấp vào nó và nhấn **4**.",
        "textTouch": "Còn một ô, và số **1** bên cạnh hàng của nó lại đặt tháp cao nhất ở gần nhất. Chạm vào nó, rồi chạm **4** trên bàn phím số."
      },
      "step6": {
        "text": "Đã giải! **Backspace** xóa trống một ô bạn điền sai, còn **Giải** trong menu tạm dừng hoàn thành câu đố đã làm khó bạn.",
        "textTouch": "Đã giải! **⌫** trên bàn phím số xóa trống một ô bạn điền sai. Trong menu tạm dừng, **Ghi chú** ghi bút chì mọi khả năng, còn **Giải** hoàn thành câu đố đã làm khó bạn."
      }
    },
    "tracks": {
      "step1": {
        "text": "Một tuyến đường ray chạy từ lối vào bên trái đến lối ra ở dưới cùng, và mỗi ô nó đi qua có đúng hai thanh ray. Các con số cho biết đường ray đi qua bao nhiêu ô của cột hoặc hàng đó."
      },
      "step2": {
        "text": "Đoạn ray ở lối vào đã chạy lên **ô trên cùng bên trái**, và cạnh trên và cạnh trái của ô đó là mép lưới. Vậy thanh ray thứ hai của nó phải đi sang phải: **nhấp** ngay bên phải tâm ô."
      },
      "step3": {
